#!/usr/bin/env bash
# =============================================================================
#
#   L I N U X   D O C T O R   —   linux-doctor_v2.sh
#
#   Crafted with love by MUHAMMAD ALI SIDDIQUI
#
#   One-shot Linux troubleshooting & health report. Reads the logs, checks the
#   hardware and the OS, hunts down the cause of freezes / hangs / zombies,
#   explains every problem in plain English, lets you pick fixes from a menu,
#   verifies each fix, and writes a visual HTML report: problem -> evidence ->
#   fix -> result.
#
#   Works on:
#     Debian family : Debian, Ubuntu, Mint, Kali, Pop!_OS, Raspberry Pi OS ...
#     RedHat family : RHEL, CentOS, Rocky, AlmaLinux, Fedora, Oracle, Amazon
#     SUSE / others : best effort (every check skips itself if a tool is missing)
#
#   Sections:
#      1. System overview            8. Services & boot
#      2. CPU                        9. Log scan (errors explained)
#      3. Memory                    10. Network & DNS
#      4. Disk & filesystems        11. System freezes & hangs (root cause)
#      5. Storage hardware          12. Security & updates
#      6. Cooling, fans & battery   13. Recent changes (what changed before it broke)
#      7. Processes & zombies
#
#   Usage:  sudo bash linux-doctor_v2.sh [options]
#      (no option)  diagnose; at the end you are asked if you want the fix menu
#      --fix        go straight to the fix menu after the report
#      --no-fix     never show the fix menu (good for cron)
#      --quick      skip slow checks (SMART, update queries, iostat, du)
#      --hours N    how far back to read logs (default 24)
#      --out DIR    where to save reports (default /var/log/linux-doctor)
#      --no-color   plain output (also: NO_COLOR env var, or output to a pipe)
#      --no-anim    no intro animation
#      --ascii      no Unicode symbols / emoji (for old consoles)
#      -h, --help   show help
#
#   Safety: diagnosis is read-only and never deletes anything. Fixes only run
#   when you select them; RISKY fixes ask a second time. Any config file a fix
#   changes is backed up first as <file>.backupN_YYYYMMDD-HHMMSS.
#
#   Exit code: 0 healthy, 1 warnings, 2 critical (after fixes) - cron friendly.
# =============================================================================

set -uo pipefail                                   # unset variable = error; failing pipe part is noticed (no -e: one failed check must not stop the run)
unset LC_ALL                                       # let the per-category locale settings below take effect
export LC_NUMERIC=C LC_MESSAGES=C                  # dot decimals + English tool output, so parsing works everywhere

# ----------------------------------------------------------------------------
#  Defaults & command-line options
# ----------------------------------------------------------------------------
VERSION="2.0"                                      # script version
AUTHOR="MUHAMMAD ALI SIDDIQUI"                     # author credit
FIX_MODE=0                                         # 0 = ask at the end, 1 = open fix menu directly, -1 = never
QUICK=0                                            # 1 = skip slow checks
HOURS=24                                           # log look-back window in hours
USE_COLOR=1                                        # 1 = colored output
FORCE_ASCII=0                                      # 1 = no Unicode
NO_ANIM=0                                          # 1 = no intro animation
OUT_DIR="/var/log/linux-doctor"                    # default report folder
TOTAL_STEPS=13                                     # number of check sections

usage() {                                          # print the help text
  cat <<EOF
Linux Doctor v${VERSION} - crafted with love by ${AUTHOR}

Usage: sudo bash $0 [options]
  (none)       diagnose, then ask whether to open the fix menu
  --fix        open the fix menu right after the report
  --no-fix     never show the fix menu (cron / automation)
  --quick      skip slow checks (SMART, update queries, iostat, du)
  --hours N    how far back to read logs (default 24)
  --out DIR    where to save reports (default /var/log/linux-doctor)
  --no-color   plain output
  --no-anim    no intro animation
  --ascii      no Unicode symbols / emoji
  -h, --help   this help
EOF
}

while [[ $# -gt 0 ]]; do                           # walk through every argument
  case "$1" in
    --fix)      FIX_MODE=1 ;;                      # open fix menu directly
    --no-fix)   FIX_MODE=-1 ;;                     # never offer fixes
    --quick)    QUICK=1 ;;                         # quick mode
    --hours)    shift; HOURS="${1:-}"              # next argument = hours
                [[ "$HOURS" =~ ^[0-9]+$ && "$HOURS" -gt 0 ]] || { echo "--hours needs a positive number"; exit 2; } ;;
    --out)      shift; OUT_DIR="${1:-}"            # custom report folder
                [[ -n "$OUT_DIR" ]] || { echo "--out needs a folder"; exit 2; } ;;
    --no-color) USE_COLOR=0 ;;                     # no colors
    --no-anim)  NO_ANIM=1 ;;                       # no animation
    --ascii)    FORCE_ASCII=1 ;;                   # no Unicode
    -h|--help)  usage; exit 0 ;;                   # help
    *)          echo "Unknown option: $1"; usage; exit 2 ;;
  esac
  shift                                            # next argument
done

# ----------------------------------------------------------------------------
#  Look & feel: colors, symbols, terminal width
# ----------------------------------------------------------------------------
[[ -t 1 && -z "${NO_COLOR:-}" ]] || USE_COLOR=0    # no colors when not on a terminal or NO_COLOR is set
(( USE_COLOR )) || NO_ANIM=1                       # no animation without colors

UTF=0                                              # assume ASCII until proven otherwise
case "${LC_CTYPE:-}${LANG:-}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UTF=1 ;; esac   # UTF-8 locale?
(( FORCE_ASCII )) && UTF=0                         # user asked for ASCII

INTERACTIVE=0                                      # can we ask the user questions?
{ : </dev/tty; } 2>/dev/null && INTERACTIVE=1      # yes if a terminal can be opened (not in cron)

COLS=$( { stty size </dev/tty; } 2>/dev/null | awk '{print $2}')   # terminal width (silent if no terminal)
[[ "$COLS" =~ ^[0-9]+$ ]] || COLS=${COLUMNS:-110}  # fallback

if (( USE_COLOR )); then                           # ANSI color codes
  R=$'\e[0m'; B=$'\e[1m'; DIM=$'\e[2m'; ITA=$'\e[3m'               # reset, bold, dim, italic
  RED=$'\e[38;5;196m'; GRN=$'\e[38;5;46m'; YEL=$'\e[38;5;220m'      # status colors
  BLU=$'\e[38;5;39m';  CYN=$'\e[38;5;51m'; MAG=$'\e[38;5;201m'      # accents
  GRY=$'\e[38;5;245m'; ORG=$'\e[38;5;208m'; PNK=$'\e[38;5;213m'; RAILC=$'\e[38;5;240m'
  BG_RED=$'\e[48;5;52m'; BG_GRN=$'\e[48;5;22m'; BG_YEL=$'\e[48;5;58m'; BG_BLU=$'\e[48;5;17m'   # badge backgrounds
else
  R=""; B=""; DIM=""; ITA=""; RED=""; GRN=""; YEL=""; BLU=""; CYN=""; MAG=""; GRY=""; ORG=""; PNK=""; RAILC=""
  BG_RED=""; BG_GRN=""; BG_YEL=""; BG_BLU=""
fi
GRAD=(51 45 39 33 63 99 135 171 207 213 219 225 231)   # banner/header gradient cyan -> magenta
RAMP=(46 82 118 154 190 226 220 214 208 202 196)        # meter gradient green -> red
c256() { (( USE_COLOR )) && printf '\e[38;5;%sm' "$1"; return 0; }   # print one 256-color code

if (( UTF )); then                                 # Unicode symbols
  S_OK="✔"; S_WARN="⚠"; S_FAIL="✖"; S_INFO="➜"; S_FIX="🛠"; S_TIP="💡"; S_DOT="•"; S_EVI="🔎"
  BAR_F="█"; BAR_E="░"; HL="━"; PG_F="▰"; PG_E="▱"; RAIL="│"
  BX_TL="╭"; BX_TR="╮"; BX_BL="╰"; BX_BR="╯"; BX_H="─"; BX_V="│"
  DB_TL="╔"; DB_BL="╚"; DB_H="═"; DB_V="║"
  SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  STEP_ICON=("" "💻" "⚡" "🧠" "💾" "🔩" "🌀" "🧟" "🚀" "📜" "🌐" "🧊" "🔒" "🕒")
  I_HOST="💻"; I_OS="🐧"; I_KER="🧬"; I_UP="⏰"; I_NET="🌐"; I_VM="📦"; I_CPU="⚡"; I_MEM="🧠"; I_FAN="🌀"; I_BAT="🔋"; I_TMP="🌡 "
else                                               # ASCII fallbacks
  S_OK="[OK]"; S_WARN="[!]"; S_FAIL="[X]"; S_INFO="->"; S_FIX="*"; S_TIP="i"; S_DOT="-"; S_EVI=">"
  BAR_F="#"; BAR_E="."; HL="="; PG_F="#"; PG_E="-"; RAIL="|"
  BX_TL="+"; BX_TR="+"; BX_BL="+"; BX_BR="+"; BX_H="-"; BX_V="|"
  DB_TL="+"; DB_BL="+"; DB_H="="; DB_V="|"
  SPIN=('|' '/' '-' '\')
  STEP_ICON=("" "" "" "" "" "" "" "" "" "" "" "" "" "")
  I_HOST="  "; I_OS="  "; I_KER="  "; I_UP="  "; I_NET="  "; I_VM="  "; I_CPU="  "; I_MEM="  "; I_FAN="  "; I_BAT="  "; I_TMP="  "
fi
HICON=("" "💻" "⚡" "🧠" "💾" "🔩" "🌀" "🧟" "🚀" "📜" "🌐" "🧊" "🔒" "🕒")   # icons for the HTML report (always emoji)
PFX="  ${RAILC}${RAIL}${R} "                       # left rail printed in front of every line inside a section

# ----------------------------------------------------------------------------
#  Small helpers
# ----------------------------------------------------------------------------
has_cmd() { command -v "$1" >/dev/null 2>&1; }     # is a tool installed?
to() { if has_cmd timeout; then timeout "$@"; else shift; "$@"; fi; }   # run with a time limit if possible
rep() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }  # repeat a string N times
num() { [[ "${1:-}" =~ ^[0-9]+$ ]] && echo "$1" || echo 0; }            # sanitize to an integer
cnt() { local n; n=$(grep -Eic -- "$1" "$2" 2>/dev/null); echo "${n:-0}"; }   # count matching lines (case-insensitive)
rd()  { cat "$1" 2>/dev/null; }                    # read a small /sys or /proc file quietly
human_kb() { awk -v k="${1:-0}" 'BEGIN{u="KMGTP";i=1;while(k>=1024&&i<5){k/=1024;i++};printf "%.1f%s",k,substr(u,i,1)}'; }   # KB -> 1.2G
dur_h() { local s=$(num "$1"); if ((s>=86400)); then echo "$((s/86400))d $((s%86400/3600))h"; elif ((s>=3600)); then echo "$((s/3600))h $((s%3600/60))m"; elif ((s>=60)); then echo "$((s/60))m $((s%60))s"; else echo "${s}s"; fi; }   # seconds -> 2h 5m
indent() { awk -v p="$PFX" -v w="$(( COLS > 40 ? COLS - 4 : 116 ))" '{print p substr($0,1,w)}'; }   # rail-prefix + trim piped text

bk() {                                             # back up a file as <file>.backupN_YYYYMMDD-HHMMSS (next free N), never overwrites
  local f=$1 n=1
  [[ -e $f ]] || return 0                          # nothing to back up
  while compgen -G "${f}.backup${n}_*" >/dev/null; do n=$((n+1)); done   # find the next free number
  cp -p "$f" "${f}.backup${n}_$(date +%Y%m%d-%H%M%S)" && echo "backup created: ${f}.backup${n}_*"
}

# ---- result storage ----------------------------------------------------------
N_CRIT=0; N_WARN=0; N_OK=0; N_INFO=0               # global counters
F_SEV=(); F_AREA=(); F_STEP=(); F_MSG=(); F_HINT=(); F_EVID=(); F_STATUS=()   # findings
FX_F=(); FX_TITLE=(); FX_CMD=(); FX_VERIFY=(); FX_RISK=(); FX_STATUS=(); FX_TIME=(); FX_OUT=()   # fixes (linked to findings)
M_AREA=(); M_LABEL=(); M_VAL=(); M_EXTRA=(); M_INV=()                         # meters
S_C=(); S_W=(); S_O=()                             # per-section counts (critical / warning / ok)
STEP_TITLES=(); CUR_AREA="General"; STEP_NO=0      # section bookkeeping
FAN_L=(); FAN_R=(); TEMP_L=(); TEMP_C=(); TEMP_X=(); BAT_JSON="null"   # cooling data for HTML
ZB_PP=(); ZB_APP=(); ZB_CMD=(); ZB_UNIT=(); ZB_CNT=(); ZB_OLD=(); ZB_PKG=(); ZB_USER=()   # zombie parents for HTML
VIRT="unknown"; UP_H="?"; IS_LAPTOP=0              # filled in by the checks
SCORE=100; SCORE_AFTER=100; FIXES_RUN=0            # health scores
declare -A FZ=([io]=0 [mem]=0 [cpu]=0 [kernel]=0 [nfs]=0 [hw]=0 [limits]=0)   # freeze-cause evidence points
declare -A FZ_TXT=(
  [io]="STORAGE: disks are slow, failing or timing out - everything freezes while waiting for the disk"
  [mem]="MEMORY: RAM runs out, the system swaps/thrashes and the OOM killer steps in"
  [cpu]="CPU: overloaded CPUs or an overcommitted VM host starve everything else"
  [kernel]="KERNEL/DRIVER: lockups, crashes or unclean resets point to a kernel, driver or firmware bug"
  [nfs]="NETWORK STORAGE: an NFS/CIFS server stops answering and every process touching it hangs"
  [hw]="HARDWARE: overheating, stopped fans or CPU/RAM errors are destabilizing the machine"
  [limits]="LIMITS: process, file or connection tables are full, so new work cannot start"
)
FZ_ORDER=()                                        # freeze causes ranked (filled in step 11)

# ---- output primitives (all lines inside a section get the rail prefix) -----
ok()   { printf '%s%s%s%s %s\n' "$PFX" "$GRN" "$S_OK" "$R" "$*"; }              # green tick line
good() { ok "$@"; N_OK=$((N_OK+1)); S_O[STEP_NO]=$(( ${S_O[STEP_NO]:-0} + 1 )); }   # tick that counts as a passed check
info() { printf '%s%s%s%s %s\n' "$PFX" "$BLU" "$S_INFO" "$R" "$*"; }           # blue info line
note() { printf '%s  %s%s%s\n' "$PFX" "$GRY" "$*" "$R"; }                       # grey detail line
kv()   { printf '%s%s%-20s%s %s\n' "$PFX" "$GRY" "$1" "$R" "$2"; }              # label / value line
skip() { printf '%s%s%s skipped:%s %s%s%s\n' "$PFX" "$GRY" "$S_DOT" "$R" "$DIM" "$*" "$R"; }   # skipped check
sub()  { printf '%s\n%s%s%s %s%s\n' "$PFX" "$PFX" "$CYN$B" "$S_DOT" "$*" "$R"; }  # sub-heading
table_head() { printf '%s%s%s%s\n' "$PFX" "$MAG$B" "$*" "$R"; }                # table header row
table_rows() { indent; }                           # table body rows

add_finding() {                                    # record + print a problem: SEV(CRIT|WARN|INFO) MESSAGE HINT [EVIDENCE]
  local sev=$1 msg=$2 hint=${3:-} evid=${4:-}
  F_SEV+=("$sev"); F_AREA+=("$CUR_AREA"); F_STEP+=("$STEP_NO"); F_MSG+=("$msg"); F_HINT+=("$hint"); F_EVID+=("$evid"); F_STATUS+=("OPEN")
  case $sev in
    CRIT) printf '%s%s %s CRITICAL %s %s%s%s\n' "$PFX" "$BG_RED$RED$B" "$S_FAIL" "$R" "$RED$B" "$msg" "$R"
          N_CRIT=$((N_CRIT+1)); S_C[STEP_NO]=$(( ${S_C[STEP_NO]:-0} + 1 )) ;;
    WARN) printf '%s%s %s WARNING %s %s%s%s\n' "$PFX" "$BG_YEL$YEL$B" "$S_WARN" "$R" "$YEL" "$msg" "$R"
          N_WARN=$((N_WARN+1)); S_W[STEP_NO]=$(( ${S_W[STEP_NO]:-0} + 1 )) ;;
    *)    printf '%s%s %s TIP %s %s\n' "$PFX" "$BG_BLU$CYN$B" "$S_TIP" "$R" "$msg"; N_INFO=$((N_INFO+1)) ;;
  esac
  if [[ -n $evid ]]; then                          # show the evidence (max 4 lines)
    printf '%s     %s%s Evidence:%s\n' "$PFX" "$GRY" "$S_EVI" "$R"
    printf '%s\n' "$evid" | head -4 | awk -v p="$PFX" -v c="$DIM" -v r="$R" '{print p "       " c substr($0,1,110) r}'
  fi
  [[ -n $hint ]] && printf '%s     %s%s Fix:%s %s\n' "$PFX" "$YEL" "$S_FIX" "$R" "$hint"   # how to fix it
  return 0
}

add_fix() {                                        # offer an automatic fix for the LAST finding: TITLE COMMAND VERIFY RISK(safe|care|risky)
  FX_F+=($(( ${#F_SEV[@]} - 1 ))); FX_TITLE+=("$1"); FX_CMD+=("$2"); FX_VERIFY+=("${3:-}"); FX_RISK+=("${4:-safe}")
  FX_STATUS+=("OPEN"); FX_TIME+=(""); FX_OUT+=("")
  printf '%s     %s%s auto-fix #%d available:%s %s %s(%s)%s\n' "$PFX" "$GRN" "$S_INFO" "${#FX_CMD[@]}" "$R" "$1" "$GRY" "${4:-safe}" "$R"
}

grad_bar() {                                       # gradient bar: PERCENT WIDTH [INVERT]
  local pct=$1 w=$2 inv=${3:-0} fill j ci out=""
  (( pct > 100 )) && pct=100
  fill=$(( pct * w / 100 ))
  if (( USE_COLOR )); then
    for ((j=0; j<w; j++)); do
      if (( j < fill )); then
        ci=$(( j * 10 / (w - 1) )); (( inv )) && ci=$(( 10 - ci ))   # color by position: green -> red (or reversed)
        out+=$'\e[38;5;'"${RAMP[ci]}m${BAR_F}"
      else out+="${RAILC}${BAR_E}"; fi
    done
    out+=$R
  else out="$(rep "$BAR_F" "$fill")$(rep "$BAR_E" $((w - fill)))"; fi
  printf '%s' "$out"
}

meter() {                                          # labelled gradient meter: LABEL PERCENT [EXTRA] [INVERT: high=good]
  local label=$1 pct extra=${3:-} inv=${4:-0} col bad
  pct=$(num "${2%.*}")
  bad=$pct; (( inv )) && bad=$(( 100 - pct ))      # how "bad" the value is
  if   (( bad >= 90 )); then col=$RED
  elif (( bad >= 70 )); then col=$YEL
  else col=$GRN; fi
  printf '%s%-18.18s %s %s%4d%%%s  %s%s%s\n' "$PFX" "$label" "$(grad_bar "$pct" 30 "$inv")" "$col$B" "$pct" "$R" "$GRY" "$extra" "$R"
  M_AREA+=("$CUR_AREA"); M_LABEL+=("$label"); M_VAL+=("$pct"); M_EXTRA+=("$extra"); M_INV+=("$inv")
}

step_end() {                                       # close the current section with its mini score line
  (( STEP_NO == 0 )) && return 0
  local c=${S_C[STEP_NO]:-0} w=${S_W[STEP_NO]:-0} o=${S_O[STEP_NO]:-0}
  printf '  %s%s%s%s %s%s %d passed%s  %s%s %d warning%s  %s%s %d critical%s\n' "$RAILC" "$BX_BL" "$(rep "$BX_H" 2)" "$R" \
    "$GRN" "$S_OK" "$o" "$R" "$YEL" "$S_WARN" "$w" "$R" "$RED" "$S_FAIL" "$c" "$R"
}

step() {                                           # big gradient section header with progress bar
  step_end                                         # close the previous section
  STEP_NO=$((STEP_NO + 1)); CUR_AREA=$1; STEP_TITLES+=("$1")
  S_C[STEP_NO]=0; S_W[STEP_NO]=0; S_O[STEP_NO]=0
  local icon=${STEP_ICON[$STEP_NO]:-} title=${1^^} done pad hdr="" j t
  done=$(( STEP_NO * 10 / TOTAL_STEPS )); pad=$(( 46 - ${#title} )); (( pad < 3 )) && pad=3
  t="$(rep "$HL" 3) [${STEP_NO}/${TOTAL_STEPS}] "   # text that gets the gradient
  if (( USE_COLOR )); then
    for ((j=0; j<${#t}; j++)); do hdr+="$(c256 "${GRAD[$(( (j + STEP_NO) % 12 ))]}")${t:j:1}"; done   # rainbow sweep, shifted per section
  else hdr=$t; fi
  echo
  printf '  %s%s%s%s %s %s%s%s %s%s%s %3d%%%s\n' "$RAILC" "$BX_TL" "$R" "$B$hdr" "$icon" "$(c256 "${GRAD[$(( STEP_NO % 12 ))]}")$B" "$title" \
    " $(rep "$HL" "$pad")$R" "$CYN" "$(rep "$PG_F" "$done")" "$RAILC$(rep "$PG_E" $((10 - done)))" $(( STEP_NO * 100 / TOTAL_STEPS )) "$R"
}

SPIN_N=0; SPIN_OUT=""; SPIN_RC=0                   # spinner state
run_spin() {                                       # run a slow command with a spinner: MESSAGE CMD [ARGS...]
  local msg=$1; shift
  SPIN_N=$((SPIN_N + 1))
  local f="$EVID/cmd_${SPIN_N}.out" i=0 pid t0=$SECONDS   # command output kept as evidence
  "$@" >"$f" 2>&1 &                                # start in the background
  pid=$!
  if [[ -t 2 ]] && (( USE_COLOR )); then           # animate only on a real terminal
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r  %s%s%s %s%s%s %s(%ds)%s ' "$CYN" "${SPIN[i++ % ${#SPIN[@]}]}" "$R" "$DIM" "$msg" "$R" "$GRY" $((SECONDS - t0)) "$R" >&2
      sleep 0.1                                    # 10 frames per second
    done
    printf '\r\e[K' >&2                            # clear the spinner line
  fi
  wait "$pid"; SPIN_RC=$?                          # exit code of the command
  SPIN_OUT=$(<"$f")                                # its output
}

ask() {                                            # yes/no question from the keyboard (prompt on screen only)
  local a=""
  printf '  %s%s [y/N]%s ' "$CYN$B" "$1" "$R" >&2
  read -r a </dev/tty 2>/dev/null || a=""
  [[ $a =~ ^[Yy] ]]
}

# ----------------------------------------------------------------------------
#  Pre-flight: who am I, which distro, where do logs live, where to save
# ----------------------------------------------------------------------------
IS_ROOT=0; [[ $EUID -eq 0 ]] && IS_ROOT=1          # running as root?

OS_ID="unknown"; OS_LIKE=""; OS_NAME="$(uname -s)"
if [[ -r /etc/os-release ]]; then                  # standard distro identification
  # shellcheck disable=SC1091
  . /etc/os-release
  OS_ID=${ID:-unknown}; OS_LIKE=${ID_LIKE:-}; OS_NAME=${PRETTY_NAME:-${NAME:-Linux}}
elif [[ -r /etc/redhat-release ]]; then            # very old RedHat
  OS_ID="rhel"; OS_NAME=$(</etc/redhat-release)
fi
case " $OS_ID $OS_LIKE " in                        # distro family
  *" debian "*|*" ubuntu "*|*" raspbian "*|*" linuxmint "*|*" pop "*|*" kali "*) FAMILY="debian" ;;
  *" rhel "*|*" fedora "*|*" centos "*|*" rocky "*|*" almalinux "*|*" ol "*|*" amzn "*) FAMILY="rhel" ;;
  *" suse "*|*" sles "*|*" opensuse"*) FAMILY="suse" ;;
  *) FAMILY="other" ;;
esac
PKG="none"; for p in apt-get dnf yum zypper; do has_cmd "$p" && { PKG=$p; break; }; done   # package manager

SYSLOG=""; AUTHLOG=""                              # classic text logs
for f in /var/log/syslog /var/log/messages; do [[ -r $f ]] && { SYSLOG=$f; break; }; done
for f in /var/log/auth.log /var/log/secure; do [[ -r $f ]] && { AUTHLOG=$f; break; }; done
HAS_JOURNAL=0; has_cmd journalctl && journalctl -n 1 -q --no-pager >/dev/null 2>&1 && HAS_JOURNAL=1   # journal readable?
HAS_SYSTEMD=0; [[ -d /run/systemd/system ]] && HAS_SYSTEMD=1   # systemd running?
SINCE="${HOURS} hours ago"                         # journal window

HOST=$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname)   # machine name
TS=$(date +%Y%m%d-%H%M%S)                          # timestamp
if ! mkdir -p "$OUT_DIR" 2>/dev/null || [[ ! -w $OUT_DIR ]]; then   # report folder writable?
  OUT_DIR="${HOME:-/tmp}/linux-doctor-reports"; mkdir -p "$OUT_DIR" 2>/dev/null || OUT_DIR="/tmp"
fi
BASE="$OUT_DIR/linux-doctor_${HOST}_${TS}"         # file prefix
TXT="$BASE.txt"; HTML="$BASE.html"; EVID="${BASE}_evidence"   # outputs
mkdir -p "$EVID"                                   # evidence folder
RAW="$EVID/terminal-output.ansi"                   # colored copy of the screen (less -R)
KLOG="$EVID/kernel.log"; ERRLOG="$EVID/errors.log"; AUTHL="$EVID/auth.log"   # log extracts

exec 3>&1                                          # keep the real screen on fd 3
exec > >(tee -a "$RAW")                            # everything printed is also saved
TEE_PID=${!:-}                                     # tee's PID (to wait for it at the end)
START_SEC=$SECONDS                                 # start time

# ============================================================================
#  BANNER (animated on a real terminal)
# ============================================================================
banner() {
  local d=0; (( NO_ANIM )) || d=0.04              # delay between banner lines
  echo
  if (( UTF )) && (( COLS >= 96 )); then          # big block letters
    local L=(
"██╗     ██╗███╗   ██╗██╗   ██╗██╗  ██╗  ██████╗  ██████╗  ██████╗████████╗ ██████╗ ██████╗ "
