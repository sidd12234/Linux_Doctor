  elif (( UTF )); then                             # compact letters
    local L=("╦  ╦╔╗╔╦ ╦═╗ ╦  ╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗" "║  ║║║║║ ║╔╩╦╝   ║║║ ║║   ║ ║ ║╠╦╝" "╩═╝╩╝╚╝╚═╝╩ ╚═  ═╩╝╚═╝╚═╝ ╩ ╚═╝╩╚═")
    local i; for i in "${!L[@]}"; do printf '  %s%s%s\n' "$(c256 "${GRAD[$((i*3))]}")$B" "${L[$i]}" "$R"; [[ $d != 0 ]] && sleep "$d"; done
