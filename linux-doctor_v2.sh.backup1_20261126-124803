    printf '  %s  For the full picture run:  sudo bash %s%s\n' "$GRY" "$0" "$R"
  fi
}

# ============================================================================
#  LOG COLLECTION (once; all sections reuse the extracts)
# ============================================================================
collect_logs() {
  if (( HAS_JOURNAL )); then journalctl -k --since "$SINCE" --no-pager -q -o short-iso >"$KLOG" 2>/dev/null; fi   # kernel log for the window
  [[ -s $KLOG ]] || dmesg -T >"$KLOG" 2>/dev/null || dmesg >"$KLOG" 2>/dev/null                                  # ring buffer fallback
  if [[ ! -s $KLOG ]]; then for f in /var/log/kern.log /var/log/messages; do [[ -r $f ]] && { tail -n 50000 "$f" | grep -i 'kernel' >"$KLOG"; break; }; done; fi
  if (( HAS_JOURNAL )); then journalctl -p err --since "$SINCE" --no-pager -q -o short-iso >"$ERRLOG" 2>/dev/null; fi   # all errors
  if [[ ! -s $ERRLOG && -n $SYSLOG ]]; then tail -n 100000 "$SYSLOG" | grep -Ei 'error|fail|crit|emerg|alert|panic|denied' >"$ERRLOG"; fi
  if (( HAS_JOURNAL )); then journalctl --since "$SINCE" --no-pager -q -o short-iso _COMM=sshd _COMM=sudo _COMM=su _COMM=login >"$AUTHL" 2>/dev/null; fi   # logins
  if [[ ! -s $AUTHL && -n $AUTHLOG ]]; then tail -n 100000 "$AUTHLOG" >"$AUTHL"; fi
  touch "$KLOG" "$ERRLOG" "$AUTHL"                 # make sure the files exist
}

# ============================================================================
#  1. SYSTEM OVERVIEW
# ============================================================================
check_overview() {
  step "System overview"
  local up_s boot_t ip kern cpu_model mem_kb users ct
  up_s=$(awk '{print int($1)}' /proc/uptime)                                   # uptime seconds
  UP_H=$(uptime -p 2>/dev/null | sed 's/^up //'); [[ -z $UP_H ]] && UP_H=$(dur_h "$up_s")
  boot_t=$(uptime -s 2>/dev/null || echo "?")                                   # boot time
  VIRT=$(systemd-detect-virt 2>/dev/null || echo "unknown"); [[ $VIRT == none ]] && VIRT="physical"   # VM or metal
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')                              # main IP
  [[ -z $ip ]] && ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4; exit}')
  kern=$(uname -r)
  cpu_model=$(awk -F: '/model name/{gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo)
  mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
  users=$(who 2>/dev/null | wc -l)
  ct=$(num "$(rd /sys/class/dmi/id/chassis_type)")                              # chassis type from firmware
  case $ct in 8|9|10|11|14|30|31|32) IS_LAPTOP=1 ;; esac                         # portable / laptop / notebook / tablet / convertible
  compgen -G "/sys/class/power_supply/BAT*" >/dev/null && IS_LAPTOP=1          # has a battery = laptop
  local mtype="server / desktop"; (( IS_LAPTOP )) && mtype="laptop"; [[ $VIRT != physical && $VIRT != unknown ]] && mtype="virtual machine ($VIRT)"
  local model; model="$(rd /sys/class/dmi/id/sys_vendor) $(rd /sys/class/dmi/id/product_name)"; model=${model# }

  local w=70 line ic lb vl                                                      # host card
  printf '%s%s%s%s%s\n' "$PFX" "$BLU" "$BX_TL" "$(rep "$BX_H" "$w")" "$R"
  for line in "$I_HOST|Host|$HOST" "$I_OS|OS|$OS_NAME" "$I_KER|Kernel|$kern ($(uname -m))" \
              "$I_VM|Machine|$mtype  ${model:0:34}" "$I_CPU|CPU|$(nproc 2>/dev/null) threads  ${cpu_model:0:40}" \
              "$I_MEM|RAM|$(human_kb "$mem_kb")" "$I_UP|Uptime|$UP_H (since $boot_t)" "$I_NET|IP|${ip:-none}  ($users login sessions)"; do
    IFS='|' read -r ic lb vl <<<"$line"
    printf '%s%s%s%s %s %s%-9s%s %s\n' "$PFX" "$BLU" "$BX_V" "$R" "$ic" "$CYN$B" "$lb" "$R" "${vl:0:58}"
  done
  printf '%s%s%s%s%s\n' "$PFX" "$BLU" "$BX_BL" "$(rep "$BX_H" "$w")" "$R"

  if (( up_s > 180*86400 )); then
    add_finding WARN "Not rebooted for $((up_s/86400)) days - security fixes for the kernel installed since then are NOT active" "Plan a maintenance reboot" "uptime: $UP_H, booted $boot_t"
  else good "Uptime looks normal ($UP_H)"; fi
  if has_cmd last; then
    local lr; lr=$(last -x -n 6 reboot shutdown 2>/dev/null | grep -Ev '^$|wtmp begins' | head -6)
    [[ -n $lr ]] && { sub "Recent reboots & shutdowns"; printf '%s\n' "$lr" | table_rows; }
  fi
}

# ============================================================================
#  2. CPU
# ============================================================================
VM_R=0; VM_B=0; VM_SI=0; VM_SO=0; VM_US=0; VM_SY=0; VM_ID=100; VM_WA=0; VM_ST=0   # vmstat results (reused later)
check_cpu() {
  step "CPU"
  local cores l1 l5 l15 lp
  cores=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
  read -r l1 l5 l15 _ </proc/loadavg                                            # load averages
  lp=$(awk -v l="$l1" -v c="$cores" 'BEGIN{printf "%d", l*100/c}')              # load as % of capacity
  if has_cmd vmstat; then
    run_spin "Sampling CPU, memory & disk activity for 5 seconds..." vmstat 1 5
    read -r VM_R VM_B VM_SI VM_SO VM_US VM_SY VM_ID VM_WA VM_ST < <(awk '
      NR==2 { for (i=1;i<=NF;i++) h[$i]=i }
      END   { print $h["r"], $h["b"], $h["si"], $h["so"], $h["us"], $h["sy"], $h["id"], $h["wa"], (("st" in h) ? $h["st"] : 0) }' <<<"$SPIN_OUT")
  fi
  VM_R=$(num "$VM_R"); VM_B=$(num "$VM_B"); VM_SI=$(num "$VM_SI"); VM_SO=$(num "$VM_SO")
  VM_US=$(num "$VM_US"); VM_SY=$(num "$VM_SY"); VM_ID=$(num "$VM_ID"); VM_WA=$(num "$VM_WA"); VM_ST=$(num "$VM_ST")

  meter "CPU busy"  $((100 - VM_ID)) "user ${VM_US}%  system ${VM_SY}%"
  meter "Load (1m)" "$lp"            "load $l1 / $l5 / $l15 on $cores threads"
  meter "IO wait"   "$VM_WA"         "CPU idle, waiting for the disk"
  (( VM_ST > 0 )) && meter "Steal" "$VM_ST" "CPU taken away by the hypervisor"
  local gov cur max
  gov=$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)              # CPU frequency policy
  cur=$(num "$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)"); max=$(num "$(rd /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)")
  (( max > 0 )) && meter "CPU clock" $(( cur * 100 / max )) "$((cur/1000)) of $((max/1000)) MHz, governor: ${gov:-?}" 1

  local tp tpid tpcpu tpcomm tpuser
  read -r tpid tpuser tpcpu tpcomm < <(ps -eo pid,user,%cpu,comm --sort=-%cpu --no-headers 2>/dev/null | head -1)   # biggest CPU user
  if awk -v l="$l5" -v c="$cores" 'BEGIN{exit !(l > c*2)}'; then
    add_finding CRIT "System is overloaded: 5-min load $l5 is more than double the $cores CPU threads" "Limit or stop the runaway process shown below" \
      "Top CPU user: $tpcomm (PID $tpid, user $tpuser) at ${tpcpu}% CPU"; FZ[cpu]=$((FZ[cpu]+2)); tp=1
  elif awk -v l="$l5" -v c="$cores" 'BEGIN{exit !(l > c)}'; then
    add_finding WARN "CPU is busier than it can handle (load $l5 on $cores threads) - everything feels slow" "Check the top processes below" \
      "Top CPU user: $tpcomm (PID $tpid, user $tpuser) at ${tpcpu}% CPU"; FZ[cpu]=$((FZ[cpu]+1)); tp=1
  else good "CPU load is healthy ($l1 on $cores threads)"; tp=0; fi
  if (( tp )) && [[ -n ${tpid:-} ]] && awk -v c="${tpcpu:-0}" 'BEGIN{exit !(c >= 50)}' && [[ $tpcomm != kworker* && $tpcomm != ksoftirqd* ]]; then
    add_fix "Lower the priority of '$tpcomm' (PID $tpid) so other programs get CPU first (renice +10)" "renice -n 10 -p $tpid" "(( \$(ps -o ni= -p $tpid) >= 10 ))" care
  fi
  if (( VM_WA >= 20 )); then
    add_finding WARN "CPUs spend ${VM_WA}% of their time waiting for the disk - storage is the bottleneck" "See section 11; find the IO hog: iotop -o" "vmstat wa=${VM_WA}% b=${VM_B} (processes blocked on IO)"; FZ[io]=$((FZ[io]+2))
  fi
  if (( VM_ST >= 10 )); then
    add_finding WARN "Hypervisor steals ${VM_ST}% CPU - the VM host is overcommitted" "Ask the virtualization admin to move or resize this VM" "vmstat st=${VM_ST}%"; FZ[cpu]=$((FZ[cpu]+1))
  fi
  sub "Top 5 CPU users"
  table_head "$(printf '%-8s %-12s %6s %6s  %s' PID USER CPU% MEM% COMMAND)"
  ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu --no-headers 2>/dev/null | head -5 | awk '{printf "%-8s %-12.12s %6s %6s  %s\n",$1,$2,$3,$4,$5}' | table_rows
  local thr; thr=$(cnt 'cpu clock throttled|temperature above threshold|thermal.*critical' "$KLOG")
  (( thr > 0 )) && { add_finding WARN "CPU was slowed down for heat $thr time(s) (thermal throttling)" "Check fans & cooling (section 6)" "$(grep -Ei 'throttled|above threshold' "$KLOG" | tail -2)"; FZ[hw]=$((FZ[hw]+1)); }
  return 0
}

# ============================================================================
#  3. MEMORY
# ============================================================================
OOM_N=0
check_memory() {
  step "Memory"
  local mt ma sf st mu su
  mt=$(awk '/^MemTotal:/{print $2}' /proc/meminfo); ma=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
  [[ -z $ma ]] && ma=$(awk '/^(MemFree|Buffers|Cached):/{s+=$2} END{print s}' /proc/meminfo)   # old kernels
  st=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo); sf=$(awk '/^SwapFree:/{print $2}' /proc/meminfo)
  mt=$(num "$mt"); ma=$(num "$ma"); st=$(num "$st"); sf=$(num "$sf"); (( mt > 0 )) || mt=1
  mu=$(( (mt - ma) * 100 / mt ))
  meter "RAM used" "$mu" "$(human_kb $((mt-ma))) of $(human_kb "$mt")"
  if (( st > 0 )); then su=$(( (st - sf) * 100 / st )); meter "Swap used" "$su" "$(human_kb $((st-sf))) of $(human_kb "$st")"
  else su=0; info "No swap configured"; fi
  local hog; hog=$(ps -eo pid,rss,comm --sort=-rss --no-headers 2>/dev/null | head -3 | while read -r p r c; do echo "$c (PID $p) uses $(human_kb "$r")"; done)   # biggest memory users

  if   (( mu >= 95 )); then add_finding CRIT "RAM is almost full (${mu}%) - the system will crawl or start killing programs" "Restart / limit the memory hog, or add RAM/swap" "$hog"; FZ[mem]=$((FZ[mem]+2))
  elif (( mu >= 85 )); then add_finding WARN "RAM usage is high (${mu}%)" "Check the top memory users below" "$hog"; FZ[mem]=$((FZ[mem]+1))
  else good "RAM usage is fine (${mu}%)"; fi
  if   (( su >= 80 )); then add_finding CRIT "Swap is ${su}% full - RAM ran out and the disk is used as memory (very slow)" "Free memory or add RAM" "$hog"; FZ[mem]=$((FZ[mem]+2))
  elif (( su >= 50 )); then add_finding WARN "Swap is ${su}% used - memory has been under pressure" "Check the top memory users below" "$hog"; FZ[mem]=$((FZ[mem]+1)); fi
  if (( st == 0 && mu >= 80 )); then
    add_finding WARN "No swap and high RAM use - one spike will trigger the out-of-memory killer" "Add a 2 GB swap file" "SwapTotal: 0"
    add_fix "Create and enable a 2 GB swap file at /swapfile (fstab backed up first)" "make_swapfile 2" "swapon --show 2>/dev/null | grep -q /swapfile" care
  fi
  sub "Top 5 memory users"
  table_head "$(printf '%-8s %-12s %6s %10s  %s' PID USER MEM% RSS COMMAND)"
  ps -eo pid,user,%mem,rss,comm --sort=-rss --no-headers 2>/dev/null | head -5 | \
    while read -r p u m r c; do printf '%-8s %-12.12s %6s %10s  %s\n' "$p" "$u" "$m" "$(human_kb "$r")" "$c"; done | table_rows
  OOM_N=$(cnt 'out of memory|oom-kill|killed process' "$KLOG")
  if (( OOM_N > 0 )); then
    local vic; vic=$(grep -Eio 'killed process [0-9]+ \([^)]+\)' "$KLOG" | sed -E 's/.*\((.*)\)/\1/' | sort | uniq -c | sort -rn | head -5 | awk '{printf "%s killed %d time(s)\n",$2,$1}')
    add_finding CRIT "The out-of-memory killer fired $OOM_N time(s): RAM ran out and programs were killed" "Give the victim app a memory limit, fix its leak, or add RAM" "$vic"; FZ[mem]=$((FZ[mem]+3))
  else good "No out-of-memory kills in the last $HOURS h"; fi
}

make_swapfile() {                                  # fix helper: create /swapfile of N GB (only called from the fix menu)
  local gb=${1:-2} fst free
  [[ -e /swapfile ]] && { echo "/swapfile already exists - not touching it"; return 1; }
  fst=$(findmnt -no FSTYPE / 2>/dev/null); [[ $fst == btrfs ]] && { echo "Root is btrfs - swap files need special setup there; skipped"; return 1; }
  free=$(df -Pk / | awk 'NR==2{print $4}'); (( free > (gb + 3) * 1048576 )) || { echo "Not enough free space on /"; return 1; }
  fallocate -l "${gb}G" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=$((gb * 1024)) status=none
  chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile || return 1
  bk /etc/fstab                                    # back up fstab before changing it
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab   # make it permanent
  swapon --show
}

# ============================================================================
#  4. DISK & FILESYSTEMS
# ============================================================================
check_disk() {
  step "Disk & filesystems"
  local fs type size used avail pct mnt p bad=0 big
  local XF=(-x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x iso9660 -x fuse.snapfuse)   # ignore pseudo filesystems
  sub "Space usage"
  while read -r fs type size used avail pct mnt; do
    p=$(num "${pct%\%}")
    meter "${mnt}" "$p" "$(human_kb "$used") used of $(human_kb "$size"), $(human_kb "$avail") free ($type)"
    if (( p >= 85 )); then
      big=""
      if (( ! QUICK )); then run_spin "Finding what fills $mnt..." to 25 du -xh --max-depth=1 "$mnt"; big=$(sort -rh <<<"$SPIN_OUT" | sed -n '2,6p'); fi
      if (( p >= 95 )); then add_finding CRIT "Filesystem $mnt is ${p}% full - programs will fail to write" "du -xh --max-depth=1 $mnt | sort -h | tail -15  (remove/move what you don't need)" "${big:-$fs $pct used}"
      else add_finding WARN "Filesystem $mnt is ${p}% full" "du -xh --max-depth=1 $mnt | sort -h | tail -15" "${big:-$fs $pct used}"; fi
      bad=1
      if [[ $mnt == / || $mnt == /var || $mnt == /var/log ]]; then          # safe space savers on system filesystems
        (( HAS_JOURNAL )) && add_fix "Shrink the systemd journal to 200 MB" "journalctl --vacuum-size=200M" "" safe
        case $PKG in
          apt-get) add_fix "Clean the apt package cache" "apt-get clean" "" safe ;;
          dnf|yum) add_fix "Clean the $PKG package cache" "$PKG clean all" "" safe ;;
        esac
      fi
    fi
  done < <(to 15 df -PT "${XF[@]}" 2>/dev/null | tail -n +2 | \
           awk '{for(i=NF;i>0;i--) if ($i ~ /^[0-9]+%$/) break; if (i<5) next
                 m=$(i+1); for(j=i+2;j<=NF;j++) m=m" "$j
                 print $1, (i>=6 ? $2 : "?"), $(i-3), $(i-2), $(i-1), $i, m}')   # columns found via the "NN%" field, any df layout works
  (( bad )) || good "All filesystems have enough free space"

  bad=0
  while read -r fs ino iu ifr ipct mnt; do                                     # inode (file-count) usage
    [[ $ipct == "-" ]] && continue
    p=$(num "${ipct%\%}")
    if (( p >= 90 )); then add_finding CRIT "Filesystem $mnt used ${p}% of its inodes - no new files can be created even with free space" \
      "Find folders with millions of small files (sessions, mail queues, caches)" "$fs: $iu of $ino inodes used"; bad=1; fi
  done < <(to 15 df -Pi "${XF[@]}" 2>/dev/null | tail -n +2)
  (( bad )) || good "Inode (file count) usage is fine"

  local ro; ro=$(awk '$4 ~ /(^|,)ro(,|$)/ && $3 ~ /^(ext[234]|xfs|btrfs|jfs|reiserfs)$/ {print $2" ("$1")"}' /proc/mounts)
  if [[ -n $ro ]]; then
    add_finding CRIT "Filesystem(s) mounted READ-ONLY - usually the kernel did this after disk errors" "Check section 5; repair with fsck from rescue mode, then reboot" "$ro"; FZ[io]=$((FZ[io]+2))
  else good "No filesystem is stuck in read-only mode"; fi

  if (( HAS_JOURNAL )); then
    local ju jb
    ju=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]'); [[ -n $ju ]] && info "Systemd journal uses $ju on disk"
    jb=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+G' | cut -d. -f1)
    if (( $(num "$jb") >= 2 )); then
      add_finding WARN "The systemd journal takes $ju of disk" "journalctl --vacuum-size=200M" "journalctl --disk-usage: $ju"
      add_fix "Shrink the systemd journal to 200 MB" "journalctl --vacuum-size=200M" "" safe
    fi
  fi
  if (( IS_ROOT )) && (( ! QUICK )); then sub "Biggest items in /var/log"; to 20 du -sh /var/log/* 2>/dev/null | sort -rh | head -5 | table_rows; fi
}

# ============================================================================
#  5. STORAGE HARDWARE
# ============================================================================
check_hardware() {
  step "Storage hardware"
  local d out ev
  if (( QUICK )); then skip "SMART disk health (quick mode)"
  elif ! has_cmd smartctl; then skip "SMART disk health - install 'smartmontools' to enable"
  elif (( ! IS_ROOT )); then skip "SMART disk health needs root"
  else
    for d in $(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1}'); do
      run_spin "Reading SMART health of /dev/$d..." to 40 smartctl -H -A "/dev/$d"
      out=$SPIN_OUT
      local realloc pend used poh
      realloc=$(awk '/Reallocated_Sector_Ct/{print $NF; exit}' <<<"$out"); pend=$(awk '/Current_Pending_Sector/{print $NF; exit}' <<<"$out")
      used=$(awk -F: '/Percentage Used/{gsub(/[ %]/,"",$2); print $2; exit}' <<<"$out")   # NVMe wear
      poh=$(awk '/Power_On_Hours/{print $NF; exit} /Power On Hours/{gsub(/[^0-9]/,"",$2); print $2; exit}' FS=: <<<"$out")
      ev="realloc=${realloc:-n/a} pending=${pend:-n/a} wear=${used:-n/a}% power-on-hours=${poh:-n/a}"
      if grep -q 'FAILED' <<<"$out"; then
        add_finding CRIT "Disk /dev/$d says it is FAILING (SMART) - back up NOW and replace it" "smartctl -a /dev/$d" "$ev"; FZ[io]=$((FZ[io]+3)); FZ[hw]=$((FZ[hw]+2))
      elif grep -Eq 'PASSED|: OK' <<<"$out"; then
        if (( $(num "$pend") > 0 )); then add_finding CRIT "Disk /dev/$d has $pend unreadable (pending) sectors - it is starting to fail" "Back up and plan replacement" "$ev"; FZ[io]=$((FZ[io]+2))
        elif (( $(num "$realloc") > 0 )); then add_finding WARN "Disk /dev/$d has remapped $realloc bad sectors" "Watch it: smartctl -A /dev/$d; replace if the number grows" "$ev"
        else good "Disk /dev/$d SMART health: PASSED"; fi
        [[ -n $used ]] && meter "/dev/$d wear" "$(num "$used")" "SSD life used"
        (( $(num "$used") >= 90 )) && add_finding WARN "SSD /dev/$d has used ${used}% of its rated life" "Plan a replacement" "$ev"
      else note "/dev/$d: SMART not available (virtual disk or unsupported controller)"; fi
    done
  fi
  if [[ -r /proc/mdstat ]] && grep -q '^md' /proc/mdstat; then
    if grep -Eq '\[[U_]*_[U_]*\]' /proc/mdstat; then add_finding CRIT "Software RAID is DEGRADED - a disk dropped out of the array" "mdadm --detail /dev/mdX ; replace and re-add the disk" "$(grep -A1 '^md' /proc/mdstat | head -4)"; FZ[hw]=$((FZ[hw]+1))
    elif grep -Eq 'recovery|resync' /proc/mdstat; then info "Software RAID is rebuilding (expect slow disks until done)"
    else good "Software RAID arrays are healthy"; fi
  fi
  local rx='I/O error|Buffer I/O|blk_update_request|EXT4-fs error|XFS .*(error|corrupt)|BTRFS error|ata[0-9.]+: .*(failed|error)|critical (medium|target) error|reset controller|nvme.*timeout'
  local derr; derr=$(cnt "$rx" "$KLOG")
  if (( derr > 0 )); then
    add_finding CRIT "Kernel logged $derr disk / filesystem error(s) - storage hardware or filesystem is in trouble" "Check cables/controller, SMART, then fsck the filesystem" "$(grep -Ei "$rx" "$KLOG" | tail -4 | cut -c1-150)"; FZ[io]=$((FZ[io]+3))
  else good "No disk or filesystem errors in the kernel log"; fi
  local mce; mce=$(cnt 'Machine check|mce:|Hardware Error|EDAC .*(CE|UE)|PCIe Bus Error' "$KLOG")
  if (( mce > 0 )); then
    add_finding CRIT "$mce hardware error(s) from CPU/RAM/PCIe (MCE/EDAC) - faulty RAM or board likely" "Run memtest86+, check vendor hardware logs (iLO/iDRAC/IPMI)" "$(grep -Ei 'Machine check|mce:|Hardware Error|EDAC|PCIe Bus Error' "$KLOG" | tail -3 | cut -c1-150)"; FZ[hw]=$((FZ[hw]+3))
  else good "No CPU / RAM / PCIe hardware errors reported"; fi
}

# ============================================================================
#  6. COOLING, FANS & BATTERY
# ============================================================================
check_cooling() {
  step "Cooling, fans & battery"
  if [[ $VIRT != physical && $VIRT != unknown ]]; then skip "virtual machine ($VIRT) - no physical fans, sensors or battery"; return 0; fi
  local h hn t v lb cr maxt=0 n=0 sens=()
  for h in /sys/class/hwmon/hwmon*; do              # every hardware monitor chip
    [[ -d $h ]] || continue
    hn=$(rd "$h/name"); hn=${hn:-hwmon}
    for t in "$h"/temp*_input; do
      [[ -r $t ]] || continue
      v=$(num "$(rd "$t")"); v=$((v / 1000)); (( v <= 0 || v > 150 )) && continue   # millidegrees -> degrees, skip junk
      lb=$(rd "${t%_input}_label"); lb="${hn}${lb:+: $lb}"
      cr=$(num "$(rd "${t%_input}_crit")"); cr=$((cr / 1000)); (( cr < 50 || cr > 150 )) && cr=100   # critical limit or 100 C
      sens+=("$v|$cr|$lb"); (( v > maxt )) && maxt=$v
    done
  done
  if (( ${#sens[@]} == 0 )); then                  # fallback: ACPI thermal zones
    for t in /sys/class/thermal/thermal_zone*/temp; do
      [[ -r $t ]] || continue
      v=$(( $(num "$(rd "$t")") / 1000 )); (( v <= 0 || v > 150 )) && continue
      sens+=("$v|100|$(rd "${t%/temp}/type")"); (( v > maxt )) && maxt=$v
    done
  fi
  if (( ${#sens[@]} > 0 )); then
    sub "${I_TMP}Temperatures (hottest first)"
    while IFS='|' read -r v cr lb; do                # show up to 10 sensors, hottest first
      n=$((n+1)); (( n > 10 )) && break
      meter "${lb:0:18}" $(( v * 100 / cr )) "${v} C  (critical at ${cr} C)"
      TEMP_L+=("$lb"); TEMP_C+=("$v"); TEMP_X+=("$cr")
      if (( v >= cr - 5 )); then add_finding CRIT "$lb is at ${v} C - right at its critical limit (${cr} C). The machine will throttle or shut down" "Check fans, airflow, dust, heatsink paste" "$lb ${v} C / crit ${cr} C"; FZ[hw]=$((FZ[hw]+2))
      elif (( v >= 85 )); then add_finding WARN "$lb runs hot at ${v} C" "Clean dust, check fan, improve airflow" "$lb ${v} C"; FZ[hw]=$((FZ[hw]+1)); fi
    done < <(printf '%s\n' "${sens[@]}" | sort -t'|' -k1,1 -rn)
    (( maxt < 85 )) && good "Temperatures are fine (hottest ${maxt} C)"
  else skip "no temperature sensors exposed"; fi

  sub "${I_FAN} Fans"
  local f rpm mn fl found=0
  for f in /sys/class/hwmon/hwmon*/fan*_input; do  # every fan the firmware reports
    [[ -r $f ]] || continue
    found=1; rpm=$(num "$(rd "$f")"); mn=$(num "$(rd "${f%_input}_min")")
    fl=$(rd "${f%_input}_label"); [[ -z $fl ]] && fl="$(rd "$(dirname "$f")/name") $(basename "${f%_input}")"
    FAN_L+=("$fl"); FAN_R+=("$rpm")
    printf '%s%s %-24.24s %s%6d RPM%s  %s\n' "$PFX" "$I_FAN" "$fl" "$CYN$B" "$rpm" "$R" "$(grad_bar $(( rpm > 6000 ? 100 : rpm * 100 / 6000 )) 20 1)"
    if (( rpm == 0 && maxt >= 70 )); then
      add_finding CRIT "Fan '$fl' is STOPPED (0 RPM) while the machine is at ${maxt} C - the fan is dead, blocked or unplugged" "Clean / replace the fan; check BIOS fan settings" "$fl: 0 RPM, hottest sensor ${maxt} C"; FZ[hw]=$((FZ[hw]+3))
    elif (( rpm == 0 )); then note "'$fl' is idle (0 RPM) - normal when the machine is cool (${maxt} C)"
    elif (( mn > 0 && rpm < mn )); then add_finding WARN "Fan '$fl' spins below its minimum ($rpm < $mn RPM) - worn bearing or dust" "Clean or replace the fan" "$fl: $rpm RPM, minimum $mn"
    else good "Fan '$fl' is spinning ($rpm RPM)"; fi
  done
  if [[ -r /proc/acpi/ibm/fan ]]; then             # ThinkPad fan interface
    found=1; rpm=$(num "$(awk '/^speed:/{print $2}' /proc/acpi/ibm/fan)")
    FAN_L+=("ThinkPad fan"); FAN_R+=("$rpm")
    printf '%s%s %-24.24s %s%6d RPM%s  level %s\n' "$PFX" "$I_FAN" "ThinkPad fan" "$CYN$B" "$rpm" "$R" "$(awk '/^level:/{print $2}' /proc/acpi/ibm/fan)"
    (( rpm == 0 && maxt >= 70 )) && add_finding CRIT "ThinkPad fan is STOPPED at ${maxt} C" "Clean / replace the fan" "ThinkPad fan 0 RPM"
  fi
  if (( ! found )); then
    if has_cmd sensors && sensors 2>/dev/null | grep -qi 'fan'; then
      sensors 2>/dev/null | grep -i 'fan' | table_rows; found=1
    elif (( IS_LAPTOP )) || [[ $VIRT == physical ]]; then
      add_finding INFO "Fan speed is not visible - the fan driver/sensors are not loaded" "Install lm-sensors and run: sensors-detect --auto" "no fan*_input in /sys/class/hwmon"
      case $PKG in
        apt-get) add_fix "Install lm-sensors and detect the fan/temperature chips" "DEBIAN_FRONTEND=noninteractive apt-get install -y lm-sensors && sensors-detect --auto" "command -v sensors" care ;;
        dnf|yum) add_fix "Install lm_sensors and detect the fan/temperature chips" "$PKG install -y lm_sensors && sensors-detect --auto" "command -v sensors" care ;;
      esac
    else
      skip "no fan sensors exposed on this machine"
    fi
  fi

  local b st cap ef ed cyc hl ac=0 a
  for a in /sys/class/power_supply/{AC,AC0,ACAD,ADP0,ADP1}/online; do [[ $(rd "$a") == 1 ]] && ac=1; done   # charger plugged in?
  for b in /sys/class/power_supply/BAT*; do        # every battery
    [[ -d $b ]] || continue
    sub "${I_BAT} Battery $(basename "$b")"
    st=$(rd "$b/status"); cap=$(num "$(rd "$b/capacity")")
    ef=$(num "$(rd "$b/energy_full")"); ed=$(num "$(rd "$b/energy_full_design")")
    (( ef == 0 )) && { ef=$(num "$(rd "$b/charge_full")"); ed=$(num "$(rd "$b/charge_full_design")"); }
    cyc=$(num "$(rd "$b/cycle_count")")
    hl=0; (( ed > 0 )) && hl=$(( ef * 100 / ed )); (( hl > 100 )) && hl=100   # health = capacity now vs when new
    meter "Charge" "$cap" "${st:-?}, charger $( ((ac)) && echo connected || echo 'not connected')" 1
    (( hl > 0 )) && meter "Battery health" "$hl" "holds ${hl}% of its design capacity, ${cyc} charge cycles" 1
    BAT_JSON=$(printf '{"name":"%s","status":"%s","cap":%d,"health":%d,"cycles":%d,"ac":%s}' "$(basename "$b")" "${st:-?}" "$cap" "$hl" "$cyc" "$( ((ac)) && echo true || echo false)")
    if (( hl > 0 && hl < 50 )); then add_finding WARN "Battery is worn out: it holds only ${hl}% of its original capacity" "Replace the battery" "$(basename "$b"): health ${hl}%, ${cyc} cycles"
    elif (( hl > 0 && hl < 75 )); then add_finding INFO "Battery has aged: ${hl}% of its original capacity left" "Expect shorter battery life; replace when it bothers you" "$(basename "$b"): ${cyc} cycles"
    elif (( hl > 0 )); then good "Battery health is good (${hl}%)"; fi
    (( cap <= 10 && ac == 0 )) && add_finding WARN "Battery is almost empty (${cap}%) and the charger is not connected" "Plug in the charger" ""
  done
  return 0
}

# ============================================================================
#  7. PROCESSES & ZOMBIES
# ============================================================================
zcount_of() { ps -eo ppid=,stat= 2>/dev/null | awk -v p="$1" '$1==p && $2 ~ /^Z/' | wc -l; }   # zombies of a parent (used by fix verification)
proc_unit() {                                      # systemd unit that owns a PID
  local u; u=$(ps -o unit= -p "$1" 2>/dev/null | tr -d ' ')
  [[ -z $u || $u == "-" ]] && u=$(grep -oE '[^/]+\.(service|scope)' "/proc/$1/cgroup" 2>/dev/null | tail -1)
  echo "${u:--}"
}
proc_pkg() {                                       # package that installed the program behind a PID
  local exe p=""; exe=$(readlink -f "/proc/$1/exe" 2>/dev/null)
  [[ -z $exe ]] && { echo "-"; return; }
  if has_cmd dpkg && p=$(dpkg -S "$exe" 2>/dev/null || dpkg -S "${exe#/usr}" 2>/dev/null); then p=${p%%:*}
  elif has_cmd rpm && p=$(rpm -qf --qf '%{NAME}\n' "$exe" 2>/dev/null); then :
  else p="-"; fi
  echo "${p:--}"
}
check_processes() {
  step "Processes & zombies"
  local all tot run slp dst zst stp
  all=$(ps -eo stat= 2>/dev/null)
  tot=$(grep -c . <<<"$all"); run=$(grep -c '^R' <<<"$all"); slp=$(grep -c '^[SI]' <<<"$all")
  dst=$(grep -c '^D' <<<"$all"); zst=$(grep -c '^Z' <<<"$all"); stp=$(grep -c '^[Tt]' <<<"$all")
  kv "Processes" "$tot total: $run running, $slp sleeping, $dst waiting on IO, $stp stopped, $zst zombie"
  if (( zst == 0 )); then good "No zombie processes"; return 0; fi

  local zl pp; zl=$(ps -eo pid=,ppid=,stat=,etimes=,comm= 2>/dev/null | awk '$3 ~ /^Z/')   # all zombies: pid ppid stat age name
  sub "Zombies grouped by the parent application that should clean them up"
  table_head "$(printf '%-8s %-18s %-26s %7s %9s  %s' PARENT APPLICATION SERVICE ZOMBIES OLDEST PACKAGE)"
  for pp in $(awk '{print $2}' <<<"$zl" | sort | uniq -c | sort -rn | awk '{print $2}'); do   # parents, most zombies first
    local zc oldest app pcmd unit pkg kids puser sev hint ev
    zc=$(awk -v p="$pp" '$2==p' <<<"$zl" | wc -l)
    oldest=$(awk -v p="$pp" '$2==p{if($4+0>m)m=$4+0} END{print m+0}' <<<"$zl")
    kids=$(awk -v p="$pp" '$2==p{printf "%s(%s) ", $5, $1}' <<<"$zl" | cut -c1-150)
    app=$(ps -o comm= -p "$pp" 2>/dev/null); app=${app:-unknown}
    puser=$(ps -o user= -p "$pp" 2>/dev/null | tr -d ' ')
    pcmd=$(tr '\0' ' ' <"/proc/$pp/cmdline" 2>/dev/null | cut -c1-120)
    unit=$(proc_unit "$pp"); pkg=$(proc_pkg "$pp")
    printf '%-8s %-18.18s %-26.26s %7d %9s  %s\n' "$pp" "$app" "$unit" "$zc" "$(dur_h "$oldest")" "$pkg" | table_rows
    ZB_PP+=("$pp"); ZB_APP+=("$app"); ZB_CMD+=("$pcmd"); ZB_UNIT+=("$unit"); ZB_CNT+=("$zc"); ZB_OLD+=("$(dur_h "$oldest")"); ZB_PKG+=("$pkg"); ZB_USER+=("${puser:-?}")
    if (( oldest < 30 && zc < 5 )); then note "PID $pp ($app): $zc short-lived zombie(s) - normal, they are cleaned up within seconds"; continue; fi
    sev=WARN; (( zc >= 100 )) && { sev=CRIT; FZ[limits]=$((FZ[limits]+1)); }
    ev=$(printf 'Parent : %s (PID %s, user %s)\nCommand: %s\nService: %s   Package: %s\nZombies: %d, oldest %s: %s' "$app" "$pp" "${puser:-?}" "${pcmd:--}" "$unit" "$pkg" "$zc" "$(dur_h "$oldest")" "$kids")
    if (( pp == 1 )); then hint="Zombies owned by PID 1 (init) can only be cleared by a reboot"
    elif [[ $unit == *.service ]]; then hint="systemctl restart $unit   (the app '$app' has a bug: it does not wait() for its children - update it)"
    else hint="kill -s CHLD $pp ; if they stay, restart or stop '$app' (kill $pp) - and update it"; fi
    add_finding "$sev" "'$app' (PID $pp) is leaving $zc zombie process(es) behind - it does not clean up its finished child processes" "$hint" "$ev"
    if (( pp != 1 )); then
      add_fix "Nudge '$app' to clean up its zombies (send SIGCHLD to PID $pp)" "kill -s CHLD $pp" "(( \$(zcount_of $pp) == 0 ))" safe
      if [[ $unit == *.service ]]; then
        local rk=care; [[ $unit =~ ^(dbus|systemd-|display-manager|gdm|sddm|lightdm|sshd|ssh)\. ]] && rk=risky   # core services restart = risky
        add_fix "Restart service $unit (the parent of the zombies)" "systemctl restart '$unit'" "(( \$(zcount_of $pp) == 0 ))" "$rk"
      elif [[ ! $app =~ ^(systemd|init|sshd|login|dbus-daemon|Xorg|gnome-shell|kthreadd)$ ]]; then
        add_fix "Stop parent '$app' (PID $pp) - init then removes the zombies" "kill $pp; sleep 3; kill -0 $pp 2>/dev/null && kill -9 $pp; true" "! kill -0 $pp 2>/dev/null" risky
      fi
    fi
  done
  return 0
}

# ============================================================================
#  8. SERVICES & BOOT
# ============================================================================
check_services() {
  step "Services & boot"
  if (( ! HAS_SYSTEMD )); then skip "systemd not in use - service checks skipped"; return 0; fi
  local failed u ev
  failed=$(systemctl --failed --no-legend --plain --no-pager 2>/dev/null | \
    awk '{for(i=1;i<=NF;i++) if ($i ~ /\.(service|socket|mount|timer|target|path|swap|automount)$/) {print $i; break}}')
  if [[ -n $failed ]]; then
    for u in $failed; do
      ev=$(journalctl -u "$u" -n 4 --no-pager -q 2>/dev/null | cut -c1-150)  # why it failed
      add_finding CRIT "Service '$u' has FAILED" "journalctl -u $u -n 50 --no-pager   (read why), then: systemctl restart $u" "$ev"
      add_fix "Restart $u" "systemctl restart '$u'" "systemctl is-active -q '$u'" safe
    done
  else good "No failed services"; fi
  local bt; bt=$(to 10 systemd-analyze 2>/dev/null | head -1)
  if [[ -n $bt ]]; then
    info "Boot: ${bt#Startup finished in }"
    grep -Eq '= *([2-9]|[1-9][0-9])min' <<<"$bt" && add_finding WARN "Boot is slow (over 2 minutes)" "systemd-analyze blame | head  (fix or disable the slowest units)" "$(to 10 systemd-analyze blame --no-pager 2>/dev/null | head -3)"
    sub "Slowest services at boot"; to 10 systemd-analyze blame --no-pager 2>/dev/null | head -5 | table_rows
  fi
  local pan seg
  pan=$(cnt 'Kernel panic|kernel BUG|Oops:|general protection fault' "$KLOG")
  (( pan > 0 )) && { add_finding CRIT "Kernel crash / bug messages found ($pan) - a driver or kernel problem" "Update the kernel and drivers" "$(grep -Ei 'Kernel panic|kernel BUG|Oops:|general protection' "$KLOG" | tail -3 | cut -c1-150)"; FZ[kernel]=$((FZ[kernel]+3)); }
  seg=$(cnt 'segfault at|traps:.*(general protection|trap)' "$KLOG")
  if (( seg > 0 )); then
    add_finding WARN "Programs crashed (segfault) $seg time(s)" "Update or reinstall the program(s) listed" \
      "$(grep -Eo '[A-Za-z0-9_.+-]+\[[0-9]+\]: segfault' "$KLOG" | sed -E 's/\[[0-9]+\].*//' | sort | uniq -c | sort -rn | head -4 | awk '{print $2" crashed "$1" time(s)"}')"
  fi
  (( pan == 0 && seg == 0 )) && good "No kernel crashes or program segfaults"
  return 0
}

# ============================================================================
#  9. LOG SCAN
# ============================================================================
PATTERNS=(                                         # regex @@ plain-English meaning
  "out of memory|oom-kill|killed process@@RAM ran out - kernel killed programs"
  "no space left on device@@A disk filled up - writes failed"
  "read-only file system@@A filesystem went read-only (usually disk errors)"
  "i/o error|buffer i/o|blk_update_request|medium error@@Disk / storage hardware errors"
  "segfault|core dumped@@A program crashed"
  "failed to start|failed with result|dependency failed@@A service could not start"
  "connection refused@@Something tried to reach a service that is down"
  "connection timed out|timed out|timeout@@Network or service too slow / unreachable"
  "permission denied|operation not permitted@@Permission, SELinux or AppArmor block"
  "authentication failure|failed password|invalid user@@Failed logins"
  "temporary failure in name resolution|name or service not known|servfail|could not resolve@@DNS (name lookup) is broken"
  "too many open files@@A program hit its open-files limit"
  "network is unreachable|link is down|nic link is down@@Network link went down"
  "certificate (verify failed|has expired)|ssl routines@@Certificate / TLS problem"
  "call trace|kernel bug|soft lockup|hung_task|blocked for more than@@Kernel stalls or bugs"
)
check_logs() {
  step "Log scan"
  local total all="$EVID/all-problems.log"
  cat "$ERRLOG" "$KLOG" >"$all" 2>/dev/null
  total=$(wc -l <"$ERRLOG")
  info "$total error-level log lines in the last $HOURS h  (source: $( ((HAS_JOURNAL)) && echo journal || echo "${SYSLOG:-none}"))"
  if (( total > 1000 )); then add_finding WARN "Very noisy error log ($total errors in $HOURS h)" "Look at the top offenders below" "$(head -3 "$ERRLOG" | cut -c1-150)"
  elif (( total > 0 )); then good "Error volume is moderate ($total lines)"
  else good "No error-level log lines"; fi
  sub "What the logs are saying (plain English)"
  table_head "$(printf '%7s  %-6s %s' COUNT LEVEL MEANING)"
  local p rx mean n hits=0
  for p in "${PATTERNS[@]}"; do
    rx=${p%%@@*}; mean=${p##*@@}
    n=$(cnt "$rx" "$all")
    if (( n > 0 )); then
      hits=1
      if (( n >= 50 )); then printf '%s%s%7d  %-6s%s %s\n' "$PFX" "$RED$B" "$n" "HIGH" "$R" "$mean"
      else printf '%s%s%7d  %-6s%s %s\n' "$PFX" "$YEL" "$n" "low" "$R" "$mean"; fi
    fi
  done
  (( hits )) || ok "None of the well-known problem patterns were found"
  local dns perm fd
  dns=$(cnt 'temporary failure in name resolution|name or service not known|could not resolve' "$all")
  (( dns >= 5 )) && add_finding WARN "DNS lookups failed $dns times in the logs" "See section 10 (Network & DNS)" "$(grep -Ei 'name resolution|could not resolve' "$all" | tail -2 | cut -c1-150)"
  fd=$(cnt 'too many open files' "$all")
  (( fd > 0 )) && { add_finding WARN "A program hit 'too many open files' ($fd times)" "Raise LimitNOFILE= in its systemd unit (or ulimit -n)" "$(grep -i 'too many open files' "$all" | tail -2 | cut -c1-150)"; FZ[limits]=$((FZ[limits]+1)); }
  perm=$(cnt 'permission denied' "$all")
  (( perm >= 50 )) && add_finding WARN "Many 'permission denied' errors ($perm)" "Check file ownership and SELinux/AppArmor (section 12)" "$(grep -i 'permission denied' "$all" | tail -2 | cut -c1-150)"
  if (( total > 0 )); then
    sub "Programs producing the most errors"
    table_head "$(printf '%7s  %s' COUNT PROGRAM)"
    awk '{for(i=2;i<=6&&i<=NF;i++) if ($i ~ /:$/ && $i !~ /^[0-9:.T+-]+:$/) {p=$i; sub(/\[[0-9]+\]:$/,"",p); sub(/:$/,"",p); print p; break}}' "$ERRLOG" | \
      sort | uniq -c | sort -rn | head -8 | awk '{printf "%7d  %s\n",$1,$2}' | table_rows
    sub "Most repeated error messages"
    table_head "$(printf '%7s  %s' COUNT MESSAGE)"
    awk '{p=4; for(i=2;i<=6&&i<=NF;i++) if ($i ~ /:$/ && $i !~ /^[0-9:.T+-]+:$/) {p=i+1; break}
          m=""; for(j=p;j<=NF;j++) m=m" "$j; gsub(/\[[0-9]+\]/,"",m); gsub(/0x[0-9a-fA-F]+/,"0x#",m); gsub(/[0-9]+/,"#",m); print substr(m,2,110)}' "$ERRLOG" | \
      sort | uniq -c | sort -rn | head -10 | awk '{c=$1; $1=""; printf "%7d %s\n",c,$0}' | table_rows
  fi
  note "Full extracts saved in: $EVID"
}

# ============================================================================
# 10. NETWORK & DNS
# ============================================================================
enable_firewall() {                                # fix helper: turn on the distro firewall without locking out SSH
  if has_cmd firewall-cmd; then systemctl enable --now firewalld && firewall-cmd --permanent --add-service=ssh && firewall-cmd --reload
  elif has_cmd ufw; then ufw allow 22/tcp && ufw --force enable
  else echo "no firewall tool installed"; return 1; fi
}
fw_active() { { has_cmd firewall-cmd && [[ $(firewall-cmd --state 2>/dev/null) == running ]]; } || { has_cmd ufw && ufw status 2>/dev/null | grep -q 'Status: active'; }; }
check_network() {
  step "Network & DNS"
  local gw=""
  if has_cmd ip; then
    sub "Interfaces"; ip -br addr 2>/dev/null | grep -v '^lo ' | table_rows
    gw=$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')
    if [[ -z $gw ]]; then add_finding CRIT "No default gateway - this machine cannot reach other networks" "Fix the network config (netplan / nmcli / ifcfg)" "$(ip route 2>/dev/null | head -4)"
    else
      kv "Default gateway" "$gw"
      if has_cmd ping; then
        if to 6 ping -c 2 -W 2 "$gw" >/dev/null 2>&1; then good "Gateway $gw answers ping"
        else add_finding WARN "Gateway $gw does not answer ping (blocked, or the link is broken)" "Check cable / VLAN / switch: ip -s link" "ping $gw: no reply"; fi
      fi
    fi
    ip -4 -o addr show scope global 2>/dev/null | grep -q inet || add_finding CRIT "No interface has an IPv4 address" "Check DHCP or static IP config (nmcli / netplan)" "$(ip -br addr 2>/dev/null | head -4)"
  fi
  local inet=0
  if has_cmd ping; then
    if to 6 ping -c 2 -W 2 1.1.1.1 >/dev/null 2>&1 || to 6 ping -c 2 -W 2 8.8.8.8 >/dev/null 2>&1; then good "Internet is reachable (ping 1.1.1.1 / 8.8.8.8)"; inet=1
    else add_finding WARN "Cannot ping the internet (1.1.1.1 / 8.8.8.8) - no route out or ICMP is blocked" "Check gateway, firewall, proxy" "ping 1.1.1.1 and 8.8.8.8: no reply"; fi
  fi
  local ns; ns=$(awk '/^nameserver/{printf "%s ",$2}' /etc/resolv.conf 2>/dev/null)
  kv "DNS servers" "${ns:-none configured}"
  if to 6 getent hosts debian.org >/dev/null 2>&1 || to 6 getent hosts redhat.com >/dev/null 2>&1; then good "DNS works (names resolve)"
  else
    if (( inet )); then add_finding CRIT "DNS is BROKEN - the internet works by IP address but names do not resolve" "Fix the nameservers (resolvectl / nmcli / /etc/resolv.conf)" "nameservers: ${ns:-none}; getent hosts debian.org failed"
    else add_finding WARN "DNS lookups fail (probably because there is no internet access)" "Check /etc/resolv.conf" "nameservers: ${ns:-none}"; fi
    systemctl is-active -q systemd-resolved 2>/dev/null && add_fix "Restart the DNS resolver (systemd-resolved)" "systemctl restart systemd-resolved" "getent hosts debian.org >/dev/null" safe
  fi
  if has_cmd ss; then
    sub "Listening ports"
    table_head "$(printf '%-6s %-28s %s' PROTO LOCAL-ADDRESS PROCESS)"
    ss -tulpn 2>/dev/null | tail -n +2 | awk '{p=$NF; if (p !~ /users/) p="-"; gsub(/users:\(\("|",.*$/,"",p); printf "%-6s %-28s %s\n",$1,$5,p}' | sort -u | head -15 | table_rows
  fi
  local fw="none"
  if fw_active; then fw="firewalld/ufw active"
  elif has_cmd nft && (( $(nft list ruleset 2>/dev/null | grep -c 'chain') > 0 )); then fw="nftables rules loaded"
  elif has_cmd iptables && (( $(iptables -S 2>/dev/null | grep -c '^-A') > 0 )); then fw="iptables rules loaded"; fi
  if [[ $fw == none ]]; then
    if (( ! IS_ROOT )); then skip "firewall status needs root"
    else
      add_finding WARN "No firewall is active - every listening port above is open to the network" "Enable firewalld (RedHat) or ufw (Debian), allowing SSH" "no firewalld/ufw/nftables/iptables rules"
      { has_cmd firewall-cmd || has_cmd ufw; } && add_fix "Enable the firewall (SSH port 22 stays open)" "enable_firewall" "fw_active" risky
    fi
  else good "Firewall: $fw"; fi
  if has_cmd timedatectl; then
    local sync svc="" s; sync=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
    [[ -z $sync ]] && sync=$(timedatectl 2>/dev/null | awk -F: '/synchronized/{gsub(/ /,"",$2); print $2}')
    if [[ $sync == yes ]]; then good "Clock is synchronized (NTP)"
    else
      for s in chronyd chrony systemd-timesyncd ntpd ntp; do systemctl list-unit-files "$s.service" 2>/dev/null | grep -q "^$s" && { svc=$s; break; }; done
      add_finding WARN "Clock is NOT synchronized - wrong time breaks logins (Kerberos/FreeIPA), TLS and log timelines" "systemctl restart ${svc:-chronyd}; chronyc tracking" "$(timedatectl 2>/dev/null | grep -Ei 'local time|synchronized|NTP service' | sed 's/^ *//')"
      [[ -n $svc ]] && add_fix "Restart the time sync service ($svc)" "systemctl restart $svc" "systemctl is-active -q $svc" safe
    fi
  fi
  local ct; ct=$(cnt 'nf_conntrack: table full|dropping packet' "$KLOG")
  if (( ct > 0 )); then
    local cmax; cmax=$(num "$(rd /proc/sys/net/netfilter/nf_conntrack_max)")
    add_finding CRIT "Connection tracking table is full - network packets are being DROPPED ($ct times)" "Raise net.netfilter.nf_conntrack_max (and make it permanent in /etc/sysctl.d)" "nf_conntrack_max=$cmax"; FZ[limits]=$((FZ[limits]+2))
    (( cmax > 0 )) && add_fix "Double the connection tracking table to $((cmax*2)) (until reboot)" "sysctl -w net.netfilter.nf_conntrack_max=$((cmax*2))" "(( \$(cat /proc/sys/net/netfilter/nf_conntrack_max) >= $((cmax*2)) ))" care
  fi
  return 0
}

# ============================================================================
# 11. SYSTEM FREEZES & HANGS
# ============================================================================
psi() { awk '{for(i=2;i<=NF;i++){split($i,a,"="); if(a[1]=="avg60") v[$1]=a[2]}} END{printf "%d %d\n", v["some"]+0, v["full"]+0}' "$1" 2>/dev/null; }   # PSI file -> "some full"
check_freeze() {
  step "System freezes & hangs"
  local n
  n=$(cnt 'blocked for more than [0-9]+ seconds' "$KLOG")
  if (( n > 0 )); then
    add_finding CRIT "$n 'hung task' event(s): programs were frozen for 2+ minutes waiting inside the kernel (almost always disk or NFS)" "Check disk health (section 5), iostat -x, NFS mounts" \
      "$(grep -Eo 'task [^ ]+ blocked for more than [0-9]+ seconds' "$KLOG" | sed -E 's/:[0-9]+ blocked/ blocked/' | sort | uniq -c | sort -rn | head -4)"; FZ[io]=$((FZ[io]+3))
  else good "No hung-task (frozen program) events"; fi
  n=$(cnt 'soft lockup|hard lockup|watchdog: BUG|rcu_(sched|preempt).*stall|rcu: INFO' "$KLOG")
  if (( n > 0 )); then
    add_finding CRIT "$n CPU lockup / RCU stall event(s): a CPU got stuck inside the kernel - the classic 'whole system freezes'" "Update kernel, firmware/BIOS and VM tools; check the driver named in the evidence" \
      "$(grep -Ei 'soft lockup|hard lockup|watchdog: BUG|rcu.*stall' "$KLOG" | tail -3 | cut -c1-150)"; FZ[kernel]=$((FZ[kernel]+4))
  else good "No CPU lockups or RCU stalls"; fi
  local dproc; dproc=$(ps -eo state,pid,wchan:28,comm --no-headers 2>/dev/null | awk '$1=="D"')
  if [[ -n $dproc ]]; then
    n=$(grep -c . <<<"$dproc")
    add_finding WARN "$n process(es) stuck RIGHT NOW in uninterruptible wait (D state) - waiting for disk or NFS" "Look at WAITING-IN: nfs/rpc = network storage, io/blk = disk" "$(awk '{printf "PID %s %s waiting in %s\n",$2,$4,$3}' <<<"$dproc" | head -4)"; FZ[io]=$((FZ[io]+1))
    grep -qiE 'nfs|rpc' <<<"$dproc" && FZ[nfs]=$((FZ[nfs]+2))
  else good "No processes stuck in D state right now"; fi
  if [[ -r /proc/pressure/cpu ]]; then
    sub "Pressure stall (% of time programs had to wait, last 60 s)"
    local r s f
    for r in cpu memory io; do
      read -r s f < <(psi "/proc/pressure/$r")
      meter "$r pressure" "$s" "full stall: ${f}%"
      if (( s >= 40 || f >= 10 )); then
        add_finding CRIT "Severe $r pressure: programs were stalled ${s}% of the time (full stall ${f}%)" "This resource is starving the system - see the matching section" "/proc/pressure/$r: some avg60=$s full avg60=$f"
        case $r in cpu) FZ[cpu]=$((FZ[cpu]+2));; memory) FZ[mem]=$((FZ[mem]+3));; io) FZ[io]=$((FZ[io]+3));; esac
      elif (( s >= 15 )); then
        add_finding WARN "Noticeable $r pressure (${s}% stall)" "" "/proc/pressure/$r: some avg60=$s"
        case $r in cpu) FZ[cpu]=$((FZ[cpu]+1));; memory) FZ[mem]=$((FZ[mem]+1));; io) FZ[io]=$((FZ[io]+1));; esac
      fi
    done
  else skip "Pressure stall info (needs kernel 4.20+)"; fi
  if (( VM_SI + VM_SO >= 1000 )); then add_finding CRIT "Memory THRASHING: swapping ${VM_SI} KB/s in, ${VM_SO} KB/s out - the system freezes while it shuffles memory to disk" "Stop the memory hog (section 3) or add RAM" "vmstat si=$VM_SI so=$VM_SO"; FZ[mem]=$((FZ[mem]+3))
  elif (( VM_SI + VM_SO >= 100 )); then add_finding WARN "Active swapping (${VM_SI}/${VM_SO} KB/s in/out)" "Memory is tight - see section 3" "vmstat si=$VM_SI so=$VM_SO"; FZ[mem]=$((FZ[mem]+1))
  else good "No memory thrashing"; fi
  (( OOM_N > 0 )) && FZ[mem]=$((FZ[mem]+1))
  if (( QUICK )); then skip "iostat disk latency (quick mode)"
  elif has_cmd iostat; then
    run_spin "Measuring disk latency for 3 seconds..." iostat -dx 3 2
    local slow
    slow=$(awk '/^Device/{split("",rows); n=0; for(i=1;i<=NF;i++) h[$i]=i; next}
                NF>3 {rows[++n]=$0}
                END{for(k=1;k<=n;k++){split(rows[k],c," "); u=("%util" in h)?c[h["%util"]]:0;
                    aw=0; if("await" in h) aw=c[h["await"]]; if("r_await" in h && c[h["r_await"]]+0>aw+0) aw=c[h["r_await"]]; if("w_await" in h && c[h["w_await"]]+0>aw+0) aw=c[h["w_await"]];
                    if (u+0>=90 || aw+0>=100) printf "%s busy %s%%, latency %s ms\n", c[1], u, aw}}' <<<"$SPIN_OUT")
    if [[ -n $slow ]]; then add_finding WARN "Disk(s) saturated or slow" "Find the IO-heavy process: iotop -o  (or pidstat -d 2)" "$slow"; FZ[io]=$((FZ[io]+2))
    else good "Disk latency and utilization look normal"; fi
  else skip "iostat disk latency - install 'sysstat' to enable"; fi
  n=$(cnt 'scsi.*timeout|task abort|nvme.*(timeout|reset)|ata[0-9.]+: (hard resetting|SRST failed)' "$KLOG")
  (( n > 0 )) && { add_finding CRIT "$n storage timeout/reset event(s): the disk stopped answering for a while = system freeze" "Check disk, controller, SAN path / multipath, VM datastore latency" "$(grep -Ei 'scsi.*timeout|task abort|nvme.*(timeout|reset)|hard resetting' "$KLOG" | tail -3 | cut -c1-150)"; FZ[io]=$((FZ[io]+3)); }
  local tn; tn=$(num "$(rd /proc/sys/kernel/tainted)")   # kernel taint flags remember past trouble
  if (( tn > 0 )); then
    local tf=""
    (( tn & 128 ))   && tf+="D=kernel died (Oops/BUG) earlier; "
    (( tn & 16 ))    && tf+="M=machine check (hardware error); "
    (( tn & 16384 )) && tf+="L=soft lockup happened; "
    (( tn & 512 ))   && tf+="W=kernel warning issued; "
    (( tn & 1 ))     && tf+="P=proprietary driver loaded; "
    (( tn & 4096 ))  && tf+="O=out-of-tree driver loaded; "
    if (( tn & (128|16|16384) )); then add_finding WARN "Kernel is 'tainted': it recorded a serious event since boot" "Read dmesg around the event; update kernel / drivers / firmware" "taint=$tn: $tf"; FZ[kernel]=$((FZ[kernel]+2))
    else note "Kernel taint $tn: ${tf:-informational}"; fi
  fi
  if (( HAS_JOURNAL )); then
    local nb prev
    nb=$(journalctl --list-boots --no-pager 2>/dev/null | wc -l)
    if (( nb > 1 )); then
      prev=$(journalctl -b -1 -n 40 --no-pager -q -o short-iso 2>/dev/null)
      if grep -Eq 'systemd-shutdown|Reached target.*(Shutdown|Power-Off|Reboot|Final Step|System Reboot)|Journal stopped|Stopping .*Journal|reboot: (Restarting|Power down)|Shutting down' <<<"$prev"; then
        good "Previous boot ended with a clean shutdown/reboot"
      else
        printf '%s\n' "$prev" >"$EVID/previous-boot-last-lines.log"
        add_finding CRIT "The previous boot ended WITHOUT a clean shutdown - crash, hard freeze, power loss or forced reset" "Read what happened just before: $EVID/previous-boot-last-lines.log" "$(tail -4 <<<"$prev" | cut -c1-150)"; FZ[kernel]=$((FZ[kernel]+2))
      fi
    else
      add_finding WARN "The journal keeps only the current boot - crashes from before the last reboot are invisible" "Make the journal persistent" "journalctl --list-boots: 1 boot"
      add_fix "Make the systemd journal persistent (keeps logs across reboots)" "mkdir -p /var/log/journal && systemd-tmpfiles --create --prefix /var/log/journal && systemctl restart systemd-journald" "[[ -d /var/log/journal ]]" safe
    fi
  fi
  n=$(cnt 'watchdog did not stop|watchdog timeout|Watchdog timer expired|hardware watchdog' "$KLOG")
  (( n > 0 )) && { add_finding WARN "Watchdog events ($n): the system was reset after it stopped responding" "Look at the previous-boot evidence" "$(grep -Ei 'watchdog' "$KLOG" | tail -2 | cut -c1-150)"; FZ[kernel]=$((FZ[kernel]+2)); }
  if [[ -d /var/crash ]] && [[ -n $(ls -A /var/crash 2>/dev/null) ]]; then
    add_finding WARN "Crash dumps exist in /var/crash - the system or an application crashed before" "ls -la /var/crash ; analyse kernel dumps with 'crash'" "$(ls -lt /var/crash 2>/dev/null | sed -n '2,4p')"; FZ[kernel]=$((FZ[kernel]+1))
  fi
  local m stuck=""
  while read -r m; do to 5 stat -t "$m" >/dev/null 2>&1 || stuck="$stuck $m"; done < <(awk '$3 ~ /^(nfs|nfs4|cifs|smb3|smbfs|fuse\.sshfs|glusterfs|ceph)$/ {print $2}' /proc/mounts)
  if [[ -n $stuck ]]; then
    add_finding CRIT "Network mount(s) not responding:$stuck - anything touching them (even ls or df) hangs" "Fix the file server / network, or lazy-unmount the mount" "stat timed out after 5 s on:$stuck"; FZ[nfs]=$((FZ[nfs]+4))
    for m in $stuck; do add_fix "Force lazy-unmount the hanging mount $m" "umount -f -l '$m'" "! mountpoint -q '$m'" risky; done
  else good "No hanging network mounts (NFS/CIFS)"; fi
  local thr tmax pmax fdu fdm ctc ctm
  thr=$(num "$(awk '{split($4,a,"/"); print a[2]}' /proc/loadavg)")
  tmax=$(num "$(rd /proc/sys/kernel/threads-max)"); pmax=$(num "$(rd /proc/sys/kernel/pid_max)")
  (( pmax > 0 && tmax > pmax )) && tmax=$pmax
  if (( tmax > 0 )); then
    meter "Threads" $(( thr * 100 / tmax )) "$thr of $tmax"
    (( thr * 100 / tmax >= 80 )) && { add_finding CRIT "Process/thread table almost full ($thr of $tmax) - new programs cannot start" "Find the process spawning threads: ps -eLf | awk '{print \$2}' | uniq -c | sort -rn | head" "threads=$thr max=$tmax"; FZ[limits]=$((FZ[limits]+3)); }
  fi
  read -r fdu _ fdm < <(rd /proc/sys/fs/file-nr); fdu=$(num "${fdu:-}"); fdm=$(num "${fdm:-}")
  if (( fdm > 0 && fdm < 9000000000000000000 )); then
    meter "Open files" $(( fdu * 100 / fdm )) "$fdu of $fdm"
    (( fdu * 100 / fdm >= 80 )) && { add_finding CRIT "System-wide open files almost exhausted ($fdu of $fdm)" "sysctl -w fs.file-max=<bigger>" "file-nr: $fdu / $fdm"; FZ[limits]=$((FZ[limits]+2)); }
  fi
  if [[ -r /proc/sys/net/netfilter/nf_conntrack_count ]]; then
    ctc=$(num "$(rd /proc/sys/net/netfilter/nf_conntrack_count)"); ctm=$(num "$(rd /proc/sys/net/netfilter/nf_conntrack_max)")
    (( ctm > 0 )) && meter "Conntrack" $(( ctc * 100 / ctm )) "$ctc of $ctm tracked connections"
  fi
  n=$(cnt 'clocksource.*unstable|Marking clocksource|time jumped|clock skew' "$KLOG")
  (( n > 0 )) && { add_finding WARN "Unstable clock source ($n): timers misbehave, can look like short freezes" "On VMs install guest tools; check the kernel clocksource" "$(grep -Ei 'clocksource' "$KLOG" | tail -2 | cut -c1-150)"; FZ[cpu]=$((FZ[cpu]+1)); }

  sub "Freeze / hang verdict"                      # rank the causes by evidence points
  local k s rank=0 col
  mapfile -t FZ_ORDER < <(for k in "${!FZ[@]}"; do (( FZ[$k] > 0 )) && echo "${FZ[$k]} $k"; done | sort -rn | awk '{print $2}')
  if (( ${#FZ_ORDER[@]} == 0 )); then printf '%s%s%s No signs of freezes or hangs in the last %s h.%s\n' "$PFX" "$GRN$B" "$S_OK" "$HOURS" "$R"
  else
    for k in "${FZ_ORDER[@]}"; do
      s=${FZ[$k]}; rank=$((rank+1)); col=$YEL; (( rank == 1 )) && col=$RED
      printf '%s%s#%d%s %s%s%s\n' "$PFX" "$col$B" "$rank" "$R" "$col" "${FZ_TXT[$k]}" "$R"
      printf '%s   evidence %s %s(%d points)%s\n' "$PFX" "$(grad_bar $(( s >= 10 ? 100 : s * 10 )) 20)" "$GRY" "$s" "$R"
    done
  fi
  return 0
}

# ============================================================================
# 12. SECURITY & UPDATES
# ============================================================================
check_security() {
  step "Security & updates"
  local fails rootok sudof ips
  fails=$(cnt 'failed password|invalid user|authentication failure' "$AUTHL")
  ips=$(grep -Ei 'failed password|invalid user' "$AUTHL" | grep -Eo 'from [0-9a-fA-F:.]+' | awk '{print $2}' | sort | uniq -c | sort -rn | head -5 | awk '{print $2" tried "$1" times"}')
  if (( fails >= 500 )); then add_finding CRIT "Brute-force attack: $fails failed logins in $HOURS h" "Install fail2ban; use SSH keys only (PasswordAuthentication no)" "$ips"
  elif (( fails >= 30 )); then add_finding WARN "$fails failed login attempts in $HOURS h" "Consider fail2ban and key-only SSH" "$ips"
  else good "Failed logins: $fails (normal)"; fi
  rootok=$(cnt 'accepted .* for root from' "$AUTHL")
  (( rootok > 0 )) && add_finding WARN "Direct root SSH logins happened ($rootok)" "Set 'PermitRootLogin no' in /etc/ssh/sshd_config and use sudo" "$(grep -Ei 'accepted .* for root from' "$AUTHL" | tail -2 | cut -c1-150)"
  sudof=$(cnt 'sudo:.*(incorrect password|not in sudoers|authentication failure)' "$AUTHL")
  (( sudof > 0 )) && add_finding WARN "$sudof failed sudo attempt(s)" "Check who tried: grep sudo $AUTHL" "$(grep -Ei 'sudo:.*(incorrect password|not in sudoers)' "$AUTHL" | tail -2 | cut -c1-150)"
  if has_cmd getenforce; then
    local se den; se=$(getenforce 2>/dev/null); kv "SELinux" "$se"
    if [[ $se != Disabled ]] && (( IS_ROOT )); then
      if has_cmd ausearch; then den=$(ausearch -m AVC,USER_AVC -ts today 2>/dev/null | grep -c 'type=AVC'); else den=$(grep -c 'avc:  denied' /var/log/audit/audit.log 2>/dev/null); fi
      den=$(num "$den")
      if (( den > 0 )); then add_finding WARN "SELinux blocked something $den time(s) today - a service may be failing because of it" "ausearch -m AVC -ts today | audit2why" \
        "$(grep 'avc:  denied' /var/log/audit/audit.log 2>/dev/null | grep -Eo 'comm="[^"]+"' | sort | uniq -c | sort -rn | head -4)"
      else good "No SELinux denials today"; fi
    fi
  fi
  local aa; aa=$(cnt 'apparmor="DENIED"' "$KLOG")
  (( aa > 0 )) && add_finding WARN "AppArmor blocked something $aa time(s)" "Check the profile (aa-status, /etc/apparmor.d)" "$(grep -Eo 'profile="[^"]+"' "$KLOG" | sort | uniq -c | sort -rn | head -4)"
  if (( QUICK )); then skip "pending updates (quick mode)"
  else
    local up=0 sec=0 secfix=""
    case $PKG in
      apt-get)
        run_spin "Checking pending updates (apt)..." bash -c 'apt list --upgradable 2>/dev/null'
        up=$(grep -c 'upgradable' <<<"$SPIN_OUT"); sec=$(grep -c -- '-security' <<<"$SPIN_OUT")
        local stamp=/var/lib/apt/periodic/update-success-stamp; [[ -f $stamp ]] || stamp=/var/cache/apt/pkgcache.bin
        [[ -f $stamp ]] && note "Package lists last refreshed: $(date -r "$stamp" '+%Y-%m-%d %H:%M')  (run 'apt update' for fresh numbers)"
        if has_cmd unattended-upgrade; then secfix="unattended-upgrade -v"; else secfix="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y upgrade"; fi ;;
      dnf|yum)
        run_spin "Checking pending updates ($PKG)..." to 120 "$PKG" -q check-update
        up=$(grep -cE '^[[:alnum:]_.+-]+\.(x86_64|noarch|aarch64|i686|ppc64le|s390x)[[:space:]]' <<<"$SPIN_OUT")
        run_spin "Checking security advisories ($PKG)..." to 120 "$PKG" -q updateinfo list --security
        sec=$(grep -cE 'Sec|RHSA|ALSA|RLSA|ELSA|FEDORA' <<<"$SPIN_OUT"); secfix="$PKG -y upgrade --security" ;;
      zypper)
        run_spin "Checking pending updates (zypper)..." to 120 zypper -q lu
        up=$(grep -c '^v ' <<<"$SPIN_OUT"); secfix="zypper -n patch --category security" ;;
    esac
    up=$(num "$up"); sec=$(num "$sec")
    if (( sec > 0 )); then
      add_finding WARN "$sec security update(s) pending ($up updates in total)" "$secfix" "$PKG reports $sec security / $up total"
      add_fix "Install pending security updates (services may restart)" "$secfix" "" care
    elif (( up > 0 )); then info "$up normal update(s) pending, no security updates"
    else good "System is up to date"; fi
  fi
  if [[ -f /var/run/reboot-required ]]; then
    add_finding WARN "A reboot is required to finish installing updates" "Plan a reboot" "$(tr '\n' ' ' </var/run/reboot-required.pkgs 2>/dev/null | cut -c1-120)"
  elif has_cmd needs-restarting && (( IS_ROOT )); then
    needs-restarting -r >/dev/null 2>&1 || add_finding WARN "A reboot is required to load updated core packages (kernel / glibc / systemd)" "Plan a reboot" "needs-restarting -r"
  fi
  if has_cmd openssl; then
    local c exp_n=0 soon_n=0 nf=0
    while IFS= read -r c; do
      openssl x509 -in "$c" -noout 2>/dev/null || continue
      nf=$((nf+1))
      if ! openssl x509 -in "$c" -noout -checkend 0 >/dev/null 2>&1; then add_finding CRIT "Certificate EXPIRED: $c" "Renew it (certbot renew / ipa-getcert / your CA)" "$(openssl x509 -in "$c" -noout -subject -enddate 2>/dev/null)"; exp_n=$((exp_n+1))
      elif ! openssl x509 -in "$c" -noout -checkend $((30*86400)) >/dev/null 2>&1; then add_finding WARN "Certificate expires within 30 days: $c" "Renew it soon" "$(openssl x509 -in "$c" -noout -subject -enddate 2>/dev/null)"; soon_n=$((soon_n+1)); fi
    done < <(find /etc/ssl /etc/pki /etc/letsencrypt/live /etc/nginx /etc/httpd /etc/apache2 /etc/ipa -maxdepth 4 \
               \( -name '*.crt' -o -name '*.pem' -o -name '*.cer' \) -not -path '*/ca-certificates/*' -not -path '/etc/ssl/certs/*' \
               -not -path '*/ca-trust/*' -not -path '*/pki/tls/certs/ca-bundle*' -not -name '*key*' 2>/dev/null | head -300)
    (( exp_n == 0 && soon_n == 0 )) && good "Certificates checked: $nf, none expiring within 30 days"
  fi
}

# ============================================================================
# 13. RECENT CHANGES
# ============================================================================
check_changes() {
  step "Recent changes"
  local cutoff ch="" n
  cutoff=$(date -d '-7 days' +%F 2>/dev/null || echo 0000-00-00)
  if [[ -r /var/log/dpkg.log ]]; then              # Debian: package history
    ch=$(cat /var/log/dpkg.log.1 /var/log/dpkg.log 2>/dev/null | awk -v d="$cutoff" '$1>=d && $3 ~ /^(install|upgrade|remove|purge)$/ {printf "%s %s  %-8s %s\n",$1,substr($2,1,5),$3,$4}' | tail -15)
    sub "Packages changed in the last 7 days (newest last)"
  elif has_cmd rpm; then                           # RedHat: newest installs
    ch=$(rpm -qa --last 2>/dev/null | head -15 | awk '{n=$1; $1=""; printf "%-45s %s\n", substr($0,2,40), n}')
    sub "Most recently installed / updated packages"
  fi
  if [[ -n $ch ]]; then printf '%s\n' "$ch" | table_rows; n=$(grep -c . <<<"$ch"); else n=0; info "No package changes found"; fi
  local etc; etc=$(find /etc -xdev -type f -mmin -$(( HOURS * 60 )) ! -name '*.backup*' ! -name '*.cache' ! -path '/etc/ld.so.cache' -printf '%TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null | sort | tail -15)
  sub "Config files in /etc changed in the last $HOURS h"
  if [[ -n $etc ]]; then printf '%s\n' "$etc" | table_rows; else ok "No config file changes"; fi
  local run new; run=$(uname -r)
  new=$(ls /boot/vmlinuz-* 2>/dev/null | sed 's#/boot/vmlinuz-##' | grep -v rescue | sort -V | tail -1)
  if [[ -n $new && $new != "$run" ]]; then add_finding INFO "A newer kernel ($new) is installed but $run is running" "Reboot to use the new kernel" "running $run, newest installed $new"
  else good "Running the newest installed kernel ($run)"; fi
  if (( (N_CRIT + N_WARN) > 0 )) && { (( n > 0 )) || [[ -n $etc ]]; }; then
    add_finding INFO "Problems were found AND the system changed recently - check whether a change above caused them" "Compare the time a problem started with the change list above" "$(printf '%s\n%s' "$ch" "$etc" | grep . | tail -3)"
  fi
}

# ============================================================================
#  SUMMARY DASHBOARD
# ============================================================================
DIG=("╔═╗" "║ ║" "╚═╝"  "╔╗ " " ║ " "═╩═"  "╔═╗" "╔═╝" "╚══"  "╔═╗" " ═╣" "╚═╝"  "╦ ╦" "╚═╣" "  ╩"
     "╔══" "╚═╗" "╚═╝"  "╔═╗" "╠═╗" "╚═╝"  "══╗" "  ║" "  ╩"  "╔═╗" "╠═╣" "╚═╝"  "╔═╗" "╚═╣" "╚═╝")   # 3-line digits 0-9
big_num() {                                        # print a number with big box-drawing digits: NUMBER COLOR
  local s=$1 col=$2 r i line
  if (( ! UTF )); then printf '      %s%s%s\n' "$col$B" "$s" "$R"; return; fi
  for r in 0 1 2; do
    line=""; for ((i=0; i<${#s}; i++)); do line+="${DIG[$(( ${s:i:1} * 3 + r ))]} "; done
    printf '      %s%s%s\n' "$col$B" "$line" "$R"
  done
}
calc_score() { local c=0 w=0 i; for ((i=0; i<${#F_SEV[@]}; i++)); do
  [[ ${F_STATUS[i]} == FIXED || ${F_STATUS[i]} == APPLIED ]] && continue    # solved problems no longer count
  [[ ${F_SEV[i]} == CRIT ]] && c=$((c+1)); [[ ${F_SEV[i]} == WARN ]] && w=$((w+1)); done
  local s=$(( 100 - c * 15 - w * 5 )); (( s < 0 )) && s=0; echo "$s"; }
score_label() { if (( $1 >= 85 )); then echo "HEALTHY"; elif (( $1 >= 60 )); then echo "NEEDS ATTENTION"; else echo "CRITICAL"; fi; }
score_col()   { if (( $1 >= 85 )); then echo "$GRN"; elif (( $1 >= 60 )); then echo "$YEL"; else echo "$RED"; fi; }

summary() {
  step_end
  SCORE=$(calc_score); SCORE_AFTER=$SCORE
  local col; col=$(score_col "$SCORE")
  echo; echo
  printf '  %s%s [SUMMARY] HEALTH REPORT %s%s\n' "$(c256 201)$B" "$(rep "$HL" 3)" "$(rep "$HL" 44)" "$R"
  echo
  printf '  %sSECTION                                  %s     %s     %s    STATUS%s\n' "$GRY$B" "$S_OK" "$S_WARN" "$S_FAIL" "$R"   # scoreboard
  local i st sc
  for ((i=1; i<=${#STEP_TITLES[@]}; i++)); do
    if (( ${S_C[i]:-0} > 0 )); then st="CRITICAL"; sc=$RED; elif (( ${S_W[i]:-0} > 0 )); then st="WARNING"; sc=$YEL; else st="OK"; sc=$GRN; fi
    printf '  %2d %s %-36.36s %s%4d%s  %s%4d%s  %s%4d%s    %s%s %s%s\n' "$i" "${STEP_ICON[i]:-}" "${STEP_TITLES[i-1]}" \
      "$GRN" "${S_O[i]:-0}" "$R" "$YEL" "${S_W[i]:-0}" "$R" "$RED" "${S_C[i]:-0}" "$R" "$sc$B" "$( ((UTF)) && echo '●' || echo '*')" "$st" "$R"
  done
  echo
  printf '  %s%s%s%s\n' "$col" "$DB_TL" "$(rep "$DB_H" 70)" "$R"
  printf '  %s%s%s  %sHEALTH SCORE%s\n' "$col" "$DB_V" "$R" "$col$B" "$R"
  big_num "$SCORE" "$col" | sed "s/^/  ${col}${DB_V}${R}/"
  printf '  %s%s%s  %s  %s%s%s\n' "$col" "$DB_V" "$R" "$(grad_bar "$SCORE" 50 1)" "$col$B" "$(score_label "$SCORE")" "$R"
  printf '  %s%s%s  %s%s %d critical%s   %s%s %d warnings%s   %s%s %d passed%s   %s%s %d tips%s\n' "$col" "$DB_V" "$R" \
    "$RED$B" "$S_FAIL" "$N_CRIT" "$R" "$YEL$B" "$S_WARN" "$N_WARN" "$R" "$GRN$B" "$S_OK" "$N_OK" "$R" "$CYN" "$S_TIP" "$N_INFO" "$R"
  printf '  %s%s%s%s\n' "$col" "$DB_BL" "$(rep "$DB_H" 70)" "$R"
  if (( N_CRIT + N_WARN > 0 )); then
    echo; printf '  %s%s FIX THESE FIRST%s\n' "$ORG$B" "$S_INFO" "$R"
    local shown=0 sev
    for sev in CRIT WARN; do
      for ((i=0; i<${#F_SEV[@]}; i++)); do
        [[ ${F_SEV[i]} == "$sev" ]] || continue
        shown=$((shown+1)); (( shown > 15 )) && break 2
        if [[ $sev == CRIT ]]; then printf '  %s%2d. %s %-10s%s %s\n' "$RED$B" "$shown" "$S_FAIL" "[${F_AREA[i]%% *}]" "$R" "${F_MSG[i]}"
        else printf '  %s%2d. %s %-10s%s %s\n' "$YEL$B" "$shown" "$S_WARN" "[${F_AREA[i]%% *}]" "$R" "${F_MSG[i]}"; fi
        [[ -n ${F_HINT[i]} ]] && printf '        %s%s %s%s\n' "$DIM" "$S_INFO" "${F_HINT[i]}" "$R"
      done
    done
    (( N_CRIT + N_WARN > 15 )) && printf '  %s...and %d more - see the full report%s\n' "$GRY" $(( N_CRIT + N_WARN - 15 )) "$R"
  else
    echo; printf '  %s%s Everything looks good. Nothing to fix.%s\n' "$GRN$B" "$S_OK" "$R"
  fi
}

# ============================================================================
#  FIX MENU (pick fixes by number; each fix is verified afterwards)
# ============================================================================
SEL=()
parse_sel() {                                      # "1,3,5-7" -> SEL=(0 2 4 5 6)
  SEL=(); local tok a b k n=${#FX_CMD[@]}
  set -f                                           # no filename globbing while splitting user input
  for tok in ${1//,/ }; do
    if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}
      for ((k=a; k<=b; k++)); do (( k >= 1 && k <= n )) && SEL+=($((k-1))); done
    elif [[ $tok =~ ^[0-9]+$ ]]; then (( tok >= 1 && tok <= n )) && SEL+=($((tok-1)))
    else printf '  %signored: %s%s\n' "$YEL" "$tok" "$R" >&2; fi
  done
  set +f
}
risk_col() { case $1 in safe) echo "$GRN";; care) echo "$YEL";; *) echo "$RED";; esac; }
stat_col() { case $1 in FIXED) echo "$GRN";; APPLIED) echo "$CYN";; FAILED) echo "$RED";; SKIPPED) echo "$GRY";; *) echo "$YEL";; esac; }

draw_menu() {                                      # the menu goes to the screen only (not into the report)
  local i n=${#FX_CMD[@]} prob
  {
    echo
    printf '  %s%s%s %s FIX MENU %s%s\n' "$GRN$B" "$DB_TL" "$(rep "$DB_H" 3)" "$S_FIX" "$(rep "$DB_H" 56)" "$R"
    printf '  %s%s%s  %s%-4s %-7s %-9s %s%s\n' "$GRN" "$DB_V" "$R" "$GRY$B" "#" "RISK" "STATUS" "ACTION   (problem it solves)" "$R"
    for ((i=0; i<n; i++)); do
      prob=${F_MSG[${FX_F[i]}]}
      printf '  %s%s%s  %s%-4s%s %s%-7s%s %s%-9s%s %s\n' "$GRN" "$DB_V" "$R" "$B" "$((i+1))" "$R" \
        "$(risk_col "${FX_RISK[i]}")$B" "${FX_RISK[i]^^}" "$R" "$(stat_col "${FX_STATUS[i]}")" "${FX_STATUS[i],,}" "$R" "${FX_TITLE[i]}"
      printf '  %s%s%s                       %s%s %s%s\n' "$GRN" "$DB_V" "$R" "$GRY" "$S_INFO" "${prob:0:80}" "$R"
    done
    printf '  %s%s%s%s\n' "$GRN" "$DB_BL" "$(rep "$DB_H" 70)" "$R"
    printf '  %sSAFE%s = harmless  %sCARE%s = changes the system  %sRISKY%s = may interrupt services/access (asks twice)\n' "$GRN$B" "$R" "$YEL$B" "$R" "$RED$B" "$R"
    printf '  Choose: numbers %s1,3,5-7%s  %s|%s  %sa%s = all SAFE fixes  %s|%s  %sq%s = finish\n' "$CYN$B" "$R" "$GRY" "$R" "$CYN$B" "$R" "$GRY" "$R" "$CYN$B" "$R"
  } >&2
}

apply_fix() {                                      # run one fix, show + record the result, verify it
  local i=$1 cmd=${FX_CMD[$1]} ver=${FX_VERIFY[$1]} risk=${FX_RISK[$1]} out rc rcol
  if [[ ${FX_STATUS[i]} == FIXED ]]; then info "Fix #$((i+1)) is already done"; return; fi
  rcol=$(risk_col "$risk")
  echo
  printf '  %s%s%s Fix #%d %s[%s]%s %s%s%s\n' "$CYN" "$BX_TL" "$R" $((i+1)) "$rcol$B" "${risk^^}" "$R" "$B" "${FX_TITLE[i]}" "$R"
  printf '  %s%s%s %sProblem:%s %s\n' "$CYN" "$BX_V" "$R" "$GRY" "$R" "${F_MSG[${FX_F[i]}]}"
  printf '  %s%s%s %sCommand:%s %s%s%s\n' "$CYN" "$BX_V" "$R" "$GRY" "$R" "$CYN" "$cmd" "$R"
  if [[ $risk == risky ]] && ! ask "RISKY: this may interrupt services or network access. Really run it?"; then
    FX_STATUS[i]=SKIPPED; FX_TIME[i]=$(date +%H:%M:%S)
    printf '  %s%s%s %s%s skipped by you%s\n' "$CYN" "$BX_BL" "$R" "$GRY" "$S_DOT" "$R"; return
  fi
  run_spin "Applying fix #$((i+1))..." eval "$cmd"                              # runs in a sub-shell; helper functions are available
  out=$SPIN_OUT; rc=$SPIN_RC; FIXES_RUN=$((FIXES_RUN+1))
  [[ -n $out ]] && tail -12 <<<"$out" | awk -v c="$CYN" -v v="$BX_V" -v r="$R" -v d="$DIM" '{print "  " c v r "   " d substr($0,1,110) r}'
  FX_OUT[i]=$(tail -40 <<<"$out"); FX_TIME[i]=$(date +%H:%M:%S)
  if (( rc != 0 )); then
    FX_STATUS[i]=FAILED; printf '  %s%s%s %s%s FAILED%s (exit code %d) - try another option or the manual hint\n' "$CYN" "$BX_BL" "$R" "$RED$B" "$S_FAIL" "$R" "$rc"
  elif [[ -n $ver ]]; then
    sleep 1                                        # give the system a moment
    if ( eval "$ver" ) >/dev/null 2>&1; then
      FX_STATUS[i]=FIXED; printf '  %s%s%s %s%s FIXED%s - verified: %s%s%s\n' "$CYN" "$BX_BL" "$R" "$GRN$B" "$S_OK" "$R" "$GRY" "$ver" "$R"
    else
      FX_STATUS[i]=FAILED; printf '  %s%s%s %s%s NOT SOLVED%s - command ran but the check still fails: %s%s%s\n' "$CYN" "$BX_BL" "$R" "$RED$B" "$S_FAIL" "$R" "$GRY" "$ver" "$R"
    fi
  else
    FX_STATUS[i]=APPLIED; printf '  %s%s%s %s%s APPLIED%s - command succeeded\n' "$CYN" "$BX_BL" "$R" "$CYN$B" "$S_OK" "$R"
  fi
}

update_status() {                                  # a finding is solved when one of its fixes worked
  local i j
  for ((i=0; i<${#F_SEV[@]}; i++)); do
    F_STATUS[i]="OPEN"
    for ((j=0; j<${#FX_F[@]}; j++)); do
      (( FX_F[j] == i )) || continue
      case ${FX_STATUS[j]} in
        FIXED)   F_STATUS[i]="FIXED" ;;
        APPLIED) [[ ${F_STATUS[i]} != FIXED ]] && F_STATUS[i]="APPLIED" ;;
        FAILED)  [[ ${F_STATUS[i]} == OPEN || ${F_STATUS[i]} == SKIPPED ]] && F_STATUS[i]="FAILED" ;;
        SKIPPED) [[ ${F_STATUS[i]} == OPEN ]] && F_STATUS[i]="SKIPPED" ;;
      esac
    done
  done
}

fix_menu() {
  local n=${#FX_CMD[@]} sel i
  (( n > 0 )) || return 0
  (( FIX_MODE == -1 )) && return 0                 # --no-fix
  if (( ! IS_ROOT )); then echo; info "$n automatic fix(es) available - re-run with sudo to use the fix menu"; return 0; fi
  if (( ! INTERACTIVE )); then echo; info "$n automatic fix(es) available - run interactively to use the fix menu"; return 0; fi
  if (( FIX_MODE == 0 )); then echo; ask "$n automatic fix(es) are available. Open the fix menu?" || return 0; fi
  echo
  printf '  %s%s [AUTO-FIX] FIXES APPLIED %s%s\n' "$(c256 46)$B" "$(rep "$HL" 3)" "$(rep "$HL" 42)" "$R"
  while true; do
    draw_menu
    printf '  %s>%s ' "$CYN$B" "$R" >&2
    read -r sel </dev/tty 2>/dev/null || sel=q
    case "$sel" in
      q|Q|"") break ;;
      a|A) SEL=(); for ((i=0; i<n; i++)); do [[ ${FX_RISK[i]} == safe && ${FX_STATUS[i]} != FIXED && ${FX_STATUS[i]} != APPLIED ]] && SEL+=("$i"); done ;;
      *) parse_sel "$sel" ;;
    esac
    if (( ${#SEL[@]} == 0 )); then printf '  %sNothing selected.%s\n' "$YEL" "$R" >&2; continue; fi
    for i in "${SEL[@]}"; do apply_fix "$i"; done
  done
  update_status
  SCORE_AFTER=$(calc_score)
  if (( FIXES_RUN > 0 )); then
    echo
    printf '  %sHealth score:%s %s%d%s %s %s%d%s  %s(%s)%s\n' "$B" "$R" "$(score_col "$SCORE")$B" "$SCORE" "$R" "$S_INFO" \
      "$(score_col "$SCORE_AFTER")$B" "$SCORE_AFTER" "$R" "$GRY" "$(score_label "$SCORE_AFTER")" "$R"
  fi
}

# ============================================================================
#  REPORTS: TXT + visual HTML
# ============================================================================
json_esc() { printf '%s' "$1" | tr -d '\000-\010\013-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's#</#<\\/#g' | awk 'NR>1{printf "\\n"} {printf "%s",$0}'; }   # text -> JSON string body
js() { printf '"%s"' "$(json_esc "$1")"; }         # quoted JSON string

build_json() {
  local i
  printf '{"meta":{"host":%s,"os":%s,"kernel":%s,"virt":%s,"uptime":%s,"date":%s,"hours":%d,"dur":%d,"before":%d,"after":%d,"passed":%d,"fixesRun":%d,"author":%s,"version":%s,"family":%s,"evid":%s,"laptop":%s},' \
    "$(js "$HOST")" "$(js "$OS_NAME")" "$(js "$(uname -r)")" "$(js "$VIRT")" "$(js "$UP_H")" "$(js "$(date '+%Y-%m-%d %H:%M %Z')")" \
    "$HOURS" $((SECONDS - START_SEC)) "$SCORE" "$SCORE_AFTER" "$N_OK" "$FIXES_RUN" "$(js "$AUTHOR")" "$(js "$VERSION")" "$(js "$FAMILY")" "$(js "$EVID")" \
    "$( ((IS_LAPTOP)) && echo true || echo false)"
  printf '"sections":['
  for ((i=0; i<${#STEP_TITLES[@]}; i++)); do (( i )) && printf ','
    printf '{"n":%d,"title":%s,"icon":%s,"crit":%d,"warn":%d,"ok":%d}' $((i+1)) "$(js "${STEP_TITLES[i]}")" "$(js "${HICON[i+1]}")" "${S_C[i+1]:-0}" "${S_W[i+1]:-0}" "${S_O[i+1]:-0}"; done
  printf '],"findings":['
  for ((i=0; i<${#F_SEV[@]}; i++)); do (( i )) && printf ','
    printf '{"id":%d,"sev":%s,"area":%s,"step":%d,"msg":%s,"hint":%s,"evid":%s,"status":%s}' "$i" "$(js "${F_SEV[i]}")" "$(js "${F_AREA[i]}")" "${F_STEP[i]}" \
      "$(js "${F_MSG[i]}")" "$(js "${F_HINT[i]}")" "$(js "${F_EVID[i]}")" "$(js "${F_STATUS[i]}")"; done
  printf '],"fixes":['
  for ((i=0; i<${#FX_CMD[@]}; i++)); do (( i )) && printf ','
    printf '{"id":%d,"f":%d,"title":%s,"cmd":%s,"verify":%s,"risk":%s,"status":%s,"time":%s,"out":%s}' "$i" "${FX_F[i]}" "$(js "${FX_TITLE[i]}")" "$(js "${FX_CMD[i]}")" \
      "$(js "${FX_VERIFY[i]}")" "$(js "${FX_RISK[i]}")" "$(js "${FX_STATUS[i]}")" "$(js "${FX_TIME[i]}")" "$(js "${FX_OUT[i]}")"; done
  printf '],"meters":['
  for ((i=0; i<${#M_LABEL[@]}; i++)); do (( i )) && printf ','
    printf '{"area":%s,"label":%s,"val":%d,"extra":%s,"inv":%d}' "$(js "${M_AREA[i]}")" "$(js "${M_LABEL[i]}")" "${M_VAL[i]}" "$(js "${M_EXTRA[i]}")" "${M_INV[i]}"; done
  printf '],"freeze":['
  for ((i=0; i<${#FZ_ORDER[@]}; i++)); do (( i )) && printf ','
    printf '{"k":%s,"score":%d,"text":%s}' "$(js "${FZ_ORDER[i]}")" "${FZ[${FZ_ORDER[i]}]}" "$(js "${FZ_TXT[${FZ_ORDER[i]}]}")"; done
  printf '],"fans":['
  for ((i=0; i<${#FAN_L[@]}; i++)); do (( i )) && printf ','; printf '{"label":%s,"rpm":%d}' "$(js "${FAN_L[i]}")" "${FAN_R[i]}"; done
  printf '],"temps":['
  for ((i=0; i<${#TEMP_L[@]}; i++)); do (( i )) && printf ','; printf '{"label":%s,"c":%d,"crit":%d}' "$(js "${TEMP_L[i]}")" "${TEMP_C[i]}" "${TEMP_X[i]}"; done
  printf '],"battery":%s,"zombies":[' "$BAT_JSON"
  for ((i=0; i<${#ZB_PP[@]}; i++)); do (( i )) && printf ','
    printf '{"ppid":%d,"app":%s,"cmd":%s,"unit":%s,"count":%d,"oldest":%s,"pkg":%s,"user":%s}' "${ZB_PP[i]}" "$(js "${ZB_APP[i]}")" "$(js "${ZB_CMD[i]}")" \
      "$(js "${ZB_UNIT[i]}")" "${ZB_CNT[i]}" "$(js "${ZB_OLD[i]}")" "$(js "${ZB_PKG[i]}")" "$(js "${ZB_USER[i]}")"; done
  printf ']}'
}

build_details() {                                  # split the text report into collapsible sections (server-side, HTML-escaped)
  local titles; titles=$(IFS='|'; echo "${STEP_TITLES[*]}")
  awk -v titles="$titles" '
    BEGIN { n = split(titles, T, "|"); open = 0 }
    {
      line = $0; gsub(/&/, "\\&amp;", line); gsub(/</, "\\&lt;", line); gsub(/>/, "\\&gt;", line)
      if (line ~ /^  (╭|\+)(━━━|===) \[[0-9]+\/[0-9]+\]/ && match(line, /\[[0-9]+\/[0-9]+\]/)) {
        num = substr(line, RSTART + 1, index(substr(line, RSTART), "/") - 2) + 0
        if (open) print "</pre></details>"
        printf "<details id=\"sec-%d\"><summary>%d. %s</summary><pre>\n", num, num, T[num]; open = 1; next
      }
      if (line ~ /^  (━━━|===) \[SUMMARY\]/)  { if (open) print "</pre></details>"; print "<details id=\"sec-summary\"><summary>Summary (text)</summary><pre>"; open = 1; next }
      if (line ~ /^  (━━━|===) \[AUTO-FIX\]/) { if (open) print "</pre></details>"; print "<details id=\"sec-fixes\"><summary>Fix session log</summary><pre>"; open = 1; next }
      sub(/^  (│|\|) ?/, "", line)                  # drop the left rail
      if (open) print line
    }
    END { if (open) print "</pre></details>" }' "$TXT"
}

