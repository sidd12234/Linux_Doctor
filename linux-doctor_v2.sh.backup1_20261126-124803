  exec 1>&3                                        # stop copying to the raw file (closes tee's input)
  if [[ -n $TEE_PID ]]; then wait "$TEE_PID" 2>/dev/null || sleep 1; else sleep 1; fi
  sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g; s/\r//g' "$RAW" >"$TXT"   # plain-text report = screen output without colors
  build_html >"$HTML"                              # visual HTML report
  local w=76
  echo
  printf '  %s%s%s%s%s\n' "$PNK" "$BX_TL" "$(rep "$BX_H" "$w")" "$BX_TR" "$R"
  printf '  %s%s%s %s%s Reports saved%s\n' "$PNK" "$BX_V" "$R" "$B" "$S_OK" "$R"
  printf '  %s%s%s   %sHTML%s  %s   %s(open in a browser)%s\n' "$PNK" "$BX_V" "$R" "$CYN$B" "$R" "$HTML" "$GRY" "$R"
  printf '  %s%s%s   %sTXT %s  %s\n' "$PNK" "$BX_V" "$R" "$CYN$B" "$R" "$TXT"
  printf '  %s%s%s   %sDATA%s  %s\n' "$PNK" "$BX_V" "$R" "$CYN$B" "$R" "$EVID"
  printf '  %s%s%s\n' "$PNK" "$BX_V" "$R"
  printf '  %s%s%s   %sCrafted with love by %s%s\n' "$PNK" "$BX_V" "$R" "$PNK" "$AUTHOR" "$R"
  printf '  %s%s%s%s%s\n' "$PNK" "$BX_BL" "$(rep "$BX_H" "$w")" "$BX_BR" "$R"
  echo
}

